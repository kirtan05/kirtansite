---
/**
 * Shell for every /learning page.
 *
 * Deliberately not BaseLayout: that one pulls in the site navbar, the grain
 * overlay, GSAP and the view transitions router. This is a private tool that
 * has to open fast on a phone on a bad connection, so it inherits the site's
 * type and colour and nothing else.
 *
 * `noindex` is belt and braces. The real protection is that these routes are
 * on-demand, host-locked, and excluded from the sitemap — a robots meta tag
 * has never stopped anything on its own.
 */
import '../styles/global.css';

interface Props {
  title: string;
  role?: 'kid' | 'coach' | null;
  /** Shown small under the title. Use for dates and staleness, not slogans. */
  subtitle?: string;
  wide?: boolean;
}

const { title, role = null, subtitle, wide = false } = Astro.props;
const path = Astro.url.pathname;

const nav =
  role === 'coach'
    ? [
        ['/learning/coach', 'Brief'],
        ['/learning/coach/grade', 'Grade'],
        ['/learning/coach/topics', 'Topics'],
        ['/learning/history', 'History'],
      ]
    : role === 'kid'
      ? [
          ['/learning/today', 'Today'],
          ['/learning/history', 'Everything'],
        ]
      : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="same-origin" />
    <meta name="theme-color" content="#0A0A0A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-bg text-text antialiased">
    <div class={`mx-auto px-5 pb-24 pt-8 ${wide ? 'max-w-5xl' : 'max-w-2xl'}`}>
      <header class="mb-8">
        <div class="flex items-baseline justify-between gap-4">
          <h1 class="font-display text-2xl font-bold tracking-tight md:text-3xl">{title}</h1>
          {
            role && (
              <div class="flex shrink-0 items-baseline gap-4">
                {/* Which of the two of you is looking at this. The two roles
                    see different pages and different data, and at a glance the
                    screens are easy to confuse — so the answer is always on
                    screen rather than inferred from the navigation. */}
                <span
                  class:list={[
                    'rounded px-2 py-0.5 font-mono text-[10px] uppercase tracking-widest',
                    role === 'coach' ? 'bg-accent/15 text-accent' : 'bg-border text-text-secondary',
                  ]}
                >
                  {role === 'coach' ? 'parent' : 'student'}
                </span>
                <form method="post" action="/learning/api/logout">
                  <button class="font-mono text-[11px] uppercase tracking-widest text-text-secondary hover:text-text">
                    sign out
                  </button>
                </form>
              </div>
            )
          }
        </div>
        {subtitle && <p class="mt-1 font-mono text-xs text-text-secondary">{subtitle}</p>}

        {
          nav.length > 0 && (
            <nav class="mt-5 flex flex-wrap gap-x-5 gap-y-2 border-t border-border/60 pt-4">
              {nav.map(([href, label]) => (
                <a
                  href={href}
                  class:list={[
                    'font-mono text-[11px] uppercase tracking-widest transition-colors',
                    path === href ? 'text-accent' : 'text-text-secondary hover:text-text',
                  ]}
                >
                  {label}
                </a>
              ))}
            </nav>
          )
        }
      </header>

      <main>
        <slot />
      </main>
    </div>

    <style is:global>
      /* Big, unmissable tap targets: half the sessions here happen one-handed
         on a phone, and a mis-tap on a grading control is silent bad data. */
      .tap {
        min-height: 48px;
      }
      /* Native form controls inherit nothing by default on mobile Safari. */
      input,
      button,
      select,
      textarea {
        font: inherit;
        color: inherit;
      }
    </style>
  </body>
</html>
