---
// /goldbill — fits the supplier's gold bill to the exact RTGS amount.
// For Mummy and Papa. Standalone page, all maths in the browser
// (src/scripts/goldbill/calc.ts). Not indexed, not in the sitemap.
const title = 'Gold bill calculator';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#7a5a12" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <main>
      <h1>Gold bill calculator</h1>
      <p class="lead">Enter what you paid by RTGS and how many grams. It gives the rate and weight for the bill.</p>

      <form id="form" autocomplete="off" onsubmit="return false">
        <label>
          <span>Amount paid (₹)</span>
          <input id="paid" type="text" inputmode="decimal" placeholder="e.g. 13,00,000" />
        </label>
        <label>
          <span>Gold bought (grams, 24K)</span>
          <input id="fine" type="text" inputmode="decimal" value="100" />
        </label>
        <div class="quick">
          <button type="button" data-g="50">50 g</button>
          <button type="button" data-g="100">100 g</button>
          <button type="button" data-g="150">150 g</button>
          <button type="button" data-g="200">200 g</button>
        </div>
        <label>
          <span>Weight on bill <em>(optional)</em></span>
          <input id="want" type="text" inputmode="decimal" placeholder="leave empty for automatic" />
          <small>Type a weight like 105 and the rate is worked out for it.</small>
        </label>
      </form>

      <section id="out" hidden>
        <div class="answer">
          <div class="big">
            <span class="k">Rate (per gram)</span>
            <span class="v" id="rate"></span>
            <button type="button" class="copy" data-copy="rate">Copy</button>
          </div>
          <div class="big">
            <span class="k">Weight (grams)</span>
            <span class="v" id="weight"></span>
            <button type="button" class="copy" data-copy="weight">Copy</button>
          </div>
        </div>

        <table class="bill">
          <tbody>
            <tr><td id="b-rxw"></td><td id="b-value"></td></tr>
            <tr><td>CGST 1.5%</td><td id="b-cgst"></td></tr>
            <tr><td>SGST 1.5%</td><td id="b-sgst"></td></tr>
            <tr class="sub"><td>Bill total</td><td id="b-total"></td></tr>
            <tr><td id="b-adj-k"></td><td id="b-adj"></td></tr>
            <tr class="total"><td>Net amount (RTGS)</td><td id="b-net"></td></tr>
          </tbody>
        </table>

        <button type="button" id="share" class="share">Share bill as image</button>

        <details id="alts-box">
          <summary>Other rate / weight options</summary>
          <ul id="alts"></ul>
        </details>

        <details class="how">
          <summary>How this is worked out</summary>
          <p>
            Starting rate = amount ÷ grams × 0.92 = <b id="base"></b>. The rate is moved by a few rupees so that
            rate × weight + 3% GST comes to the paid amount within 50 paise.
          </p>
        </details>

        <p id="note" class="note" hidden></p>
      </section>

      <p id="empty" class="hint">Type the amount to see the bill.</p>
    </main>

    <script>
      import { baseRate, rateForWeight, solve, type Bill } from '../../scripts/goldbill/calc';

      const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
      const paidEl = $<HTMLInputElement>('paid');
      const fineEl = $<HTMLInputElement>('fine');
      const wantEl = $<HTMLInputElement>('want');
      const out = $('out');
      const empty = $('empty');
      const note = $('note');

      const rs = (n: number) =>
        '₹' + n.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      const num = (n: number) => n.toFixed(2);
      const parse = (s: string) => parseFloat(s.replace(/[,₹\s]/g, ''));

      let current: Bill | null = null;
      let currentPaid = 0;

      function show(b: Bill, paid: number) {
        current = b;
        currentPaid = paid;
        $('rate').textContent = num(b.rate);
        $('weight').textContent = num(b.weight);
        $('b-rxw').textContent = `${num(b.rate)} × ${num(b.weight)} g`;
        $('b-value').textContent = rs(b.value);
        $('b-cgst').textContent = rs(b.cgst);
        $('b-sgst').textContent = rs(b.sgst);
        $('b-total').textContent = rs(b.total);
        // Round-off line, as on the bill: Less when the total is over, Add when under.
        const d = b.diff;
        $('b-adj-k').textContent = d > 0 ? 'Less' : 'Add';
        $('b-adj').textContent = d > 0 ? '−' + num(d) : '+' + num(-d);
        $('b-net').textContent = rs(paid);
      }

      // The bill as a picture, for WhatsApp. Only the numbers: no notes, no site name.
      function billImage(b: Bill, paid: number): Promise<Blob | null> {
        const W = 1080, pad = 70, row = 92;
        const rows: [string, string, string?][] = [
          ['Rate (per gram)', '₹' + num(b.rate), 'big'],
          ['Weight', num(b.weight) + ' g', 'big'],
          ['', '', 'gap'],
          [`${num(b.rate)} × ${num(b.weight)} g`, rs(b.value)],
          ['CGST 1.5%', rs(b.cgst)],
          ['SGST 1.5%', rs(b.sgst)],
          ['Bill total', rs(b.total), 'bold'],
          [b.diff > 0 ? 'Less' : 'Add', b.diff > 0 ? '−' + num(b.diff) : '+' + num(-b.diff)],
          ['Net amount (RTGS)', rs(paid), 'net'],
        ];
        const H = pad * 2 + 110 + rows.length * row;
        const c = document.createElement('canvas');
        c.width = W;
        c.height = H;
        const x = c.getContext('2d')!;
        x.fillStyle = '#fbf7ee';
        x.fillRect(0, 0, W, H);
        const font = (size: number, weight = 400) =>
          `${weight} ${size}px system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif`;
        x.fillStyle = '#9a7215';
        x.font = font(54, 800);
        x.textBaseline = 'middle';
        x.fillText('Gold bill', pad, pad + 30);
        x.fillStyle = '#6f6352';
        x.font = font(34);
        x.textAlign = 'right';
        x.fillText(new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }), W - pad, pad + 30);
        let y = pad + 110;
        for (const [k, v, kind] of rows) {
          const mid = y + row / 2;
          if (kind === 'gap') {
            x.fillStyle = '#e7dcc4';
            x.fillRect(pad, mid, W - pad * 2, 3);
          } else {
            if (kind === 'net') {
              x.fillStyle = '#f3e6c4';
              x.fillRect(pad - 20, y + 6, W - pad * 2 + 40, row - 12);
            }
            const big = kind === 'big';
            x.fillStyle = big ? '#6f6352' : '#2a2116';
            x.font = font(big ? 40 : 40, kind === 'bold' || kind === 'net' ? 700 : 400);
            x.textAlign = 'left';
            x.fillText(k, pad, mid);
            x.fillStyle = '#2a2116';
            x.font = font(big ? 64 : 42, big || kind === 'net' ? 800 : kind === 'bold' ? 700 : 400);
            x.textAlign = 'right';
            x.fillText(v, W - pad, mid);
          }
          y += row;
        }
        return new Promise((res) => c.toBlob(res, 'image/png'));
      }

      $('share').addEventListener('click', async () => {
        if (!current) return;
        const blob = await billImage(current, currentPaid);
        if (!blob) return;
        const name = `gold-bill-${num(current.weight)}g.png`;
        const file = new File([blob], name, { type: 'image/png' });
        if (navigator.canShare?.({ files: [file] })) {
          try {
            await navigator.share({ files: [file] });
          } catch {}
          return;
        }
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = name;
        a.click();
        setTimeout(() => URL.revokeObjectURL(a.href), 5000);
      });

      function setNote(text: string, warn: boolean) {
        // Only warnings are shown, at the bottom: the page gets shown to the supplier.
        note.textContent = text;
        note.hidden = !warn;
      }

      function run() {
        const paid = parse(paidEl.value);
        const fine = parse(fineEl.value);
        const want = parse(wantEl.value);
        document.querySelectorAll<HTMLButtonElement>('.quick button').forEach((btn) =>
          btn.classList.toggle('on', Number(btn.dataset.g) === fine),
        );
        const altsBox = $<HTMLDetailsElement>('alts-box');
        const alts = $('alts');
        if (!(paid > 0) || (!(fine > 0) && !(want > 0))) {
          out.hidden = true;
          empty.hidden = false;
          return;
        }
        out.hidden = false;
        empty.hidden = true;
        $('base').textContent = fine > 0 ? num(baseRate(paid, fine)) : '—';

        if (want > 0) {
          const a = rateForWeight(paid, want)!;
          show(a.bill, paid);
          altsBox.hidden = true;
          if (!a.exact) setNote('Could not match within 50 paise. This is the closest — please check.', true);
          else if (a.bill.weight !== a.asked)
            setNote(`${num(a.asked)} g could not fit to the rupee, so the weight is ${num(a.bill.weight)} g.`, true);
          else setNote(`Rate worked out for ${num(a.asked)} g.`, false);
          return;
        }

        const a = solve(paid, fine);
        if (!a.bills.length) return;
        show(a.bills[0], paid);
        if (!a.exact) setNote('Could not match within 50 paise. This is the closest — please check.', true);
        else if (a.spread > 4) setNote(`Rate had to move up to ₹${a.spread} from the starting rate to fit.`, true);
        else setNote('Matches the paid amount within 50 paise.', false);

        altsBox.hidden = false;
        alts.replaceChildren(
          ...a.bills.slice(0, 8).map((b, i) => {
            const li = document.createElement('li');
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.textContent = `Rate ${num(b.rate)} · Weight ${num(b.weight)} g`;
            btn.className = i === 0 ? 'on' : '';
            btn.onclick = () => {
              alts.querySelectorAll('button').forEach((x) => x.classList.remove('on'));
              btn.classList.add('on');
              show(b, paid);
            };
            li.append(btn);
            return li;
          }),
        );
      }

      for (const el of [paidEl, fineEl, wantEl]) el.addEventListener('input', run);
      document.querySelectorAll<HTMLButtonElement>('.quick button').forEach((btn) =>
        btn.addEventListener('click', () => {
          fineEl.value = btn.dataset.g!;
          run();
        }),
      );
      document.querySelectorAll<HTMLButtonElement>('.copy').forEach((btn) =>
        btn.addEventListener('click', async () => {
          if (!current) return;
          const v = num(btn.dataset.copy === 'rate' ? current.rate : current.weight);
          try {
            await navigator.clipboard.writeText(v);
            btn.textContent = 'Copied';
            setTimeout(() => (btn.textContent = 'Copy'), 1200);
          } catch {}
        }),
      );
      run();
    </script>

    <style is:global>
      :root {
        --bg: #fbf7ee;
        --card: #ffffff;
        --ink: #2a2116;
        --muted: #6f6352;
        --gold: #9a7215;
        --gold-soft: #f3e6c4;
        --line: #e7dcc4;
        --ok: #1f7a3a;
        --warn: #a3470d;
        color-scheme: light;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font: 18px/1.45 system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      }
      main { max-width: 34rem; margin: 0 auto; padding: 20px 16px 48px; }
      h1 { font-size: 1.6rem; margin: 0 0 4px; color: var(--gold); }
      .lead { margin: 0 0 18px; color: var(--muted); }
      label { display: block; margin-bottom: 14px; }
      label span { display: block; font-weight: 600; margin-bottom: 6px; }
      label em { font-weight: 400; color: var(--muted); font-style: normal; }
      label small { display: block; color: var(--muted); font-size: 0.85rem; margin-top: 4px; }
      input {
        width: 100%;
        font: inherit;
        font-size: 1.5rem;
        padding: 12px 14px;
        border: 2px solid var(--line);
        border-radius: 12px;
        background: var(--card);
        color: var(--ink);
      }
      input::placeholder { font-size: 1.05rem; }
      input:focus { outline: none; border-color: var(--gold); }
      button { font: inherit; cursor: pointer; }
      .quick { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: -4px 0 18px; }
      .quick button, #alts button {
        padding: 10px 6px;
        border: 2px solid var(--line);
        border-radius: 10px;
        background: var(--card);
        color: var(--ink);
      }
      .quick button.on, #alts button.on { border-color: var(--gold); background: var(--gold-soft); font-weight: 700; }
      .answer { display: grid; gap: 10px; }
      .big {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        background: var(--card);
        border: 2px solid var(--gold);
        border-radius: 14px;
        padding: 12px 14px;
      }
      .big .k { grid-column: 1 / -1; color: var(--muted); font-size: 0.95rem; }
      .big .v { font-size: 2.3rem; font-weight: 800; letter-spacing: 0.01em; font-variant-numeric: tabular-nums; }
      .copy {
        border: 0;
        background: var(--gold);
        color: #fff;
        border-radius: 8px;
        padding: 8px 14px;
        font-size: 0.95rem;
      }
      .answer { margin-bottom: 14px; }
      .share {
        width: 100%;
        margin-top: 14px;
        padding: 14px;
        border: 0;
        border-radius: 12px;
        background: #1f7a3a;
        color: #fff;
        font-weight: 700;
        font-size: 1.1rem;
      }
      .note { margin: 14px 0 0; font-size: 0.85rem; color: var(--warn); }
      .bill {
        width: 100%;
        border-collapse: collapse;
        background: var(--card);
        border-radius: 12px;
        overflow: hidden;
        font-variant-numeric: tabular-nums;
      }
      .bill td { padding: 9px 12px; border-bottom: 1px solid var(--line); }
      .bill td:last-child { text-align: right; white-space: nowrap; }
      .bill .sub td { font-weight: 700; }
      .bill .total td { font-weight: 800; background: var(--gold-soft); border-bottom: 0; }
      details { margin: 18px 0 0; }
      summary { cursor: pointer; font-weight: 600; color: var(--gold); padding: 6px 0; }
      #alts { list-style: none; padding: 0; margin: 8px 0 0; display: grid; gap: 6px; }
      #alts button { width: 100%; text-align: left; font-size: 0.95rem; font-variant-numeric: tabular-nums; }
      .how { color: var(--muted); font-size: 0.9rem; }
      .how summary { color: var(--muted); font-weight: 400; font-size: 0.9rem; }
      .hint { color: var(--muted); }
    </style>
  </body>
</html>
