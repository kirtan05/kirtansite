---
export const prerender = false;

/**
 * /gree — GRE (and TOEFL) English trainer.
 *
 * Signed out: the password form. Signed in: the app shell, which fetches its
 * content and progress from /gree/api/* and runs the study engine on the
 * device (see src/scripts/gree/). Progress is stored in the GREE_DB D1
 * database, so phone, office laptop and home laptop all see the same state.
 */
import {
  COOKIE,
  cookieOptions,
  currentEpoch,
  env as getEnv,
  hostAllowed,
  issueCookie,
  readCookie,
  verifyPassword,
} from '../../lib/gree/guard';

if (!hostAllowed(Astro)) return new Response('Not found', { status: 404 });

const env = getEnv(Astro);
const db = env.GREE_DB;
const secret = env.GREE_COOKIE_KEY;
if (!db || !secret) return new Response('/gree is not configured on this deployment.', { status: 503 });

let signedIn = false;
const existing = await readCookie(secret, Astro.cookies.get(COOKIE)?.value);
if (existing && existing.e === (await currentEpoch(db))) signedIn = true;

let error: string | null = null;
if (!signedIn && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (await verifyPassword(env.GREE_PW, String(form.get('password') ?? ''))) {
    const { value, maxAge } = await issueCookie(secret, await currentEpoch(db));
    Astro.cookies.set(COOKIE, value, cookieOptions(maxAge));
    return Astro.redirect('/gree');
  }
  error = 'Wrong password. Try again.';
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="same-origin" />
    <meta name="theme-color" content="#F3F4F7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#10142B" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;0,7..72,700;1,7..72,400&family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>gree</title>
  </head>
  <body>
    {
      signedIn ? (
        <div id="app">
          <nav class="tabs" aria-label="Sections">
            <a href="#study" data-tab="study">Words</a>
            <a href="#practice" data-tab="practice">Questions</a>
            <a href="#write" data-tab="write">Writing</a>
            <a href="#progress" data-tab="progress">Progress</a>
          </nav>
          <main id="view" tabindex="-1">
            <p class="muted loading">Loading your words…</p>
          </main>
          <div id="toast" role="status" aria-live="polite"></div>
        </div>
      ) : (
        <main class="login">
          <h1 class="brand">gree</h1>
          <p class="muted">GRE and TOEFL English, every day.</p>
          <form method="post">
            <input type="password" name="password" autocomplete="current-password" autofocus required placeholder="Password" aria-label="Password" />
            <button type="submit" class="btn primary">Open</button>
            {error && <p class="err">{error}</p>}
          </form>
        </main>
      )
    }

    <style is:global>
      :root {
        --paper: #f3f4f7;
        --card: #ffffff;
        --ink: #18204a;
        --ink-2: #545c80;
        --rule: #d7dbe6;
        --hi: #f5d63d;
        --hi-ink: #18204a;
        --ok: #1b8454;
        --ok-bg: #e2f3ea;
        --bad: #bf3a31;
        --bad-bg: #fbe6e4;
        --focus: #3a55d9;
        --serif: 'Literata', Georgia, serif;
        --sans: 'Instrument Sans', system-ui, -apple-system, sans-serif;
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --paper: #10142b;
          --card: #181f40;
          --ink: #e8ebf7;
          --ink-2: #9ca4c8;
          --rule: #2b3462;
          --hi: #ecca2c;
          --hi-ink: #10142b;
          --ok: #52c68f;
          --ok-bg: #173a33;
          --bad: #f07a70;
          --bad-bg: #3d2030;
          --focus: #8fa4ff;
          color-scheme: dark;
        }
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        background: var(--paper);
        color: var(--ink);
        font: 16px/1.5 var(--sans);
        -webkit-text-size-adjust: 100%;
        -webkit-tap-highlight-color: transparent;
      }
      :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
      button, input, select, textarea { font: inherit; color: inherit; }
      a { color: inherit; }
      .muted { color: var(--ink-2); }
      .small { font-size: 0.875rem; }
      .err { color: var(--bad); margin: 0.5rem 0 0; }

      /* ── login */
      .login { max-width: 22rem; margin: 18vh auto 0; padding: 0 16px; }
      .login form { display: grid; gap: 0.75rem; margin-top: 2rem; }
      .login input {
        padding: 0.8rem 1rem; border: 1px solid var(--rule); border-radius: 10px; background: var(--card);
      }
      .brand { font: 700 3.25rem/1 var(--serif); letter-spacing: -0.02em; margin: 0; }

      /* ── shell */
      #app { max-width: 42rem; margin: 0 auto; padding: 0 16px calc(84px + env(safe-area-inset-bottom)); }
      .tabs {
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 10;
        display: grid; grid-template-columns: repeat(4, 1fr);
        background: var(--card); border-top: 1px solid var(--rule);
        padding-bottom: env(safe-area-inset-bottom);
      }
      .tabs a {
        text-decoration: none; text-align: center; padding: 0.9rem 0.25rem; font-weight: 500;
        color: var(--ink-2); font-size: 0.95rem;
      }
      .tabs a[aria-current='page'] { color: var(--ink); box-shadow: inset 0 3px 0 var(--hi); }
      @media (min-width: 720px) {
        #app { padding-bottom: 4rem; }
        .tabs {
          position: sticky; top: 0; bottom: auto; background: var(--paper);
          border-top: 0; border-bottom: 1px solid var(--rule); margin: 0 -16px 0;
        }
        .tabs a[aria-current='page'] { box-shadow: inset 0 -3px 0 var(--hi); }
      }
      main#view { padding-top: 1.5rem; outline: none; }
      .loading { padding-top: 3rem; }

      h2 { font: 600 1.6rem/1.2 var(--serif); margin: 0 0 0.25rem; letter-spacing: -0.01em; }
      h3 { font: 600 1.1rem/1.3 var(--sans); margin: 1.75rem 0 0.6rem; }
      p { margin: 0.4rem 0; }

      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;
        border: 1px solid var(--rule); background: var(--card); border-radius: 10px;
        padding: 0.7rem 1.1rem; font-weight: 500; cursor: pointer; text-decoration: none; min-height: 44px;
      }
      .btn.primary { background: var(--ink); color: var(--paper); border-color: var(--ink); }
      .btn.wide { width: 100%; }
      .btn:disabled { opacity: 0.45; cursor: default; }
      .btn.link { border: 0; background: none; padding: 0.4rem 0; min-height: 0; color: var(--ink-2); text-decoration: underline; }
      .row { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; }
      .spread { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }

      /* ── the headword: the one loud thing in the app */
      .head {
        font: 700 clamp(2.4rem, 11vw, 3.6rem)/1.05 var(--serif); letter-spacing: -0.02em; margin: 0.2rem 0 0;
        overflow-wrap: anywhere;
      }
      .head .mark {
        background-image: linear-gradient(var(--hi), var(--hi));
        background-repeat: no-repeat; background-position: 0 100%; background-size: 0% 0.16em;
        padding-bottom: 0.06em;
        transition: background-size 380ms cubic-bezier(.2,.7,.2,1);
      }
      .head .mark.on { background-size: 100% 0.16em; }
      .pos { font: italic 400 1.05rem var(--serif); color: var(--ink-2); }
      .plain { font: 600 1.25rem/1.35 var(--sans); margin: 1rem 0 0.25rem; }
      .def { color: var(--ink-2); }
      .ex { font: 400 1.1rem/1.6 var(--serif); margin: 1.1rem 0; padding-left: 0.9rem; border-left: 3px solid var(--rule); }
      .ex b { font-weight: 700; }
      .facts { display: grid; gap: 0.55rem; margin: 1rem 0 1.4rem; }
      .facts div { display: grid; grid-template-columns: 6.5rem 1fr; gap: 0.5rem; }
      .facts dt { color: var(--ink-2); font-size: 0.9rem; padding-top: 0.1rem; }
      .facts dd { margin: 0; }
      .trap { background: var(--bad-bg); border-radius: 8px; padding: 0.55rem 0.8rem; font-size: 0.95rem; }

      .progressline { height: 4px; background: var(--rule); border-radius: 2px; overflow: hidden; margin: 0 0 1.1rem; }
      .progressline i { display: block; height: 100%; background: var(--ink); transition: width 250ms; }
      .kicker { color: var(--ink-2); font-size: 0.9rem; }

      .prompt { font: 400 1.2rem/1.6 var(--serif); margin: 0.75rem 0 1.1rem; }
      .prompt .blank { display: inline-block; min-width: 4.5em; border-bottom: 2px solid var(--ink); margin: 0 0.15em; }
      .opts { display: grid; gap: 0.55rem; }
      .opt {
        text-align: left; border: 1px solid var(--rule); background: var(--card); border-radius: 10px;
        padding: 0.8rem 0.95rem; cursor: pointer; min-height: 48px; line-height: 1.4;
        display: flex; gap: 0.7rem; align-items: baseline;
      }
      .opt .k { color: var(--ink-2); font-size: 0.8rem; min-width: 0.9rem; }
      .opt.sel { border-color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
      .opt.right { border-color: var(--ok); background: var(--ok-bg); }
      .opt.wrong { border-color: var(--bad); background: var(--bad-bg); }
      .opt:disabled { cursor: default; color: inherit; }
      .opt.serif { font-family: var(--serif); font-size: 1.05rem; }
      .blanks { display: grid; gap: 1rem; }
      @media (min-width: 620px) { .blanks.n2 { grid-template-columns: 1fr 1fr; } .blanks.n3 { grid-template-columns: 1fr 1fr 1fr; } }
      .blanks h4 { margin: 0 0 0.4rem; font: 500 0.9rem var(--sans); color: var(--ink-2); }

      .verdict { margin: 1rem 0; padding: 0.8rem 1rem; border-radius: 10px; }
      .verdict.ok { background: var(--ok-bg); }
      .verdict.no { background: var(--bad-bg); }
      .verdict strong { display: block; margin-bottom: 0.2rem; }
      .gloss { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin-top: 0.6rem; font-size: 0.92rem; }
      .gloss span b { font-family: var(--serif); }

      .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr)); gap: 0.6rem; margin: 1rem 0; }
      .stat { background: var(--card); border: 1px solid var(--rule); border-radius: 10px; padding: 0.75rem 0.9rem; }
      .stat b { display: block; font: 600 1.6rem/1.1 var(--serif); }
      .stat { min-width: 0; }
      .stat span { color: var(--ink-2); font-size: 0.88rem; }

      .ladder { display: flex; height: 14px; border-radius: 7px; overflow: hidden; background: var(--rule); margin: 0.6rem 0; }
      .ladder i { display: block; height: 100%; }
      .legend { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; font-size: 0.88rem; color: var(--ink-2); }
      .legend i { display: inline-block; width: 0.7rem; height: 0.7rem; border-radius: 2px; margin-right: 0.35rem; vertical-align: -1px; }

      .heat { display: grid; grid-auto-flow: column; grid-template-rows: repeat(7, 14px); grid-auto-columns: 14px; justify-content: start; gap: 3px; overflow-x: auto; padding-bottom: 4px; }
      .heat i { width: 14px; height: 14px; border-radius: 3px; background: var(--rule); display: block; }
      .heat i[data-l='1'] { background: color-mix(in srgb, var(--hi) 35%, var(--rule)); }
      .heat i[data-l='2'] { background: color-mix(in srgb, var(--hi) 65%, var(--rule)); }
      .heat i[data-l='3'] { background: var(--hi); }
      .heat i[data-l='4'] { background: var(--ink); }
      .heat i.future { background: transparent; }

      table.list { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
      table.list td { padding: 0.55rem 0.3rem; border-bottom: 1px solid var(--rule); vertical-align: top; }
      table.list td.num { text-align: right; white-space: nowrap; }

      .field { display: grid; gap: 0.3rem; margin: 0.6rem 0; }
      .field label { font-size: 0.9rem; color: var(--ink-2); }
      .field input, .field select, textarea {
        padding: 0.65rem 0.8rem; border: 1px solid var(--rule); border-radius: 10px; background: var(--card); width: 100%;
      }
      textarea.essay { min-height: 55vh; font: 400 1.05rem/1.65 var(--serif); resize: vertical; }
      .bar { position: sticky; top: 0; z-index: 5; background: var(--paper); padding: 0.6rem 0; display: flex; justify-content: space-between; align-items: center; gap: 0.8rem; }
      @media (min-width: 720px) { .bar { top: 50px; } }
      .clock { font: 600 1.2rem var(--sans); font-variant-numeric: tabular-nums; }
      .clock.late { color: var(--bad); }
      .checks label { display: flex; gap: 0.6rem; align-items: flex-start; padding: 0.4rem 0; }
      .checks input { margin-top: 0.3rem; width: 1.1rem; height: 1.1rem; }
      .seg { display: flex; flex-wrap: wrap; gap: 0.4rem; }
      .seg button { border: 1px solid var(--rule); background: var(--card); border-radius: 999px; padding: 0.45rem 0.9rem; cursor: pointer; min-height: 40px; }
      .seg button[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
      .note { background: var(--card); border: 1px solid var(--rule); border-radius: 10px; padding: 0.9rem 1rem; margin: 1rem 0; }
      .feedback { white-space: pre-wrap; font-size: 0.95rem; }
      ul.plain-list { padding-left: 1.1rem; margin: 0.4rem 0; }
      ul.plain-list li { margin: 0.3rem 0; }

      #toast {
        position: fixed; left: 50%; bottom: calc(76px + env(safe-area-inset-bottom)); transform: translateX(-50%);
        background: var(--ink); color: var(--paper); padding: 0.55rem 1rem; border-radius: 999px; font-size: 0.9rem;
        opacity: 0; pointer-events: none; transition: opacity 200ms; white-space: nowrap;
      }
      #toast.on { opacity: 1; }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { transition: none !important; animation: none !important; }
      }
    </style>

    {signedIn && <script src="../../scripts/gree/app.ts"></script>}
  </body>
</html>
