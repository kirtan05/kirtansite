---
import BaseLayout from '../layouts/BaseLayout.astro';

// Data comes from the library Worker at /api/library, a Workers route on this
// hostname in front of Pages, beside spine's /api/reading. Fetched client-side
// because this page is prerendered and the list changes whenever a reel is filed.
const TABS = [
  { type: 'book', label: 'Books' },
  { type: 'film', label: 'Films' },
  { type: 'show', label: 'Shows' },
  { type: 'recipe', label: 'Recipes' },
  { type: 'music', label: 'Music' },
  { type: 'tool', label: 'Tools' },
  { type: 'place', label: 'Places' },
  { type: 'other', label: 'Other' },
];
---

<BaseLayout
  title="Instalibrary · Kirtan Jain"
  description="What I want to read, watch, cook, hear, try and visit, what I have finished, and the reel that put each one there."
>
  <section class="mx-auto max-w-4xl px-6 py-12 md:py-20" id="library">
    <div data-scroll-animate>
      <h1 class="font-display text-4xl font-bold md:text-5xl">Instalibrary</h1>
      <p class="mt-3 text-lg text-text-secondary">
        Things I mean to read, watch, cook, hear, try and visit. Most arrive from reels I send myself;
        each entry links back to the one that suggested it.
      </p>
    </div>

    <div class="mt-10 flex flex-wrap gap-2" role="tablist" aria-label="Kind" id="library-tabs">
      {
        TABS.map((tab) => (
          <button
            type="button"
            role="tab"
            data-type={tab.type}
            aria-selected="false"
            class="library-tab rounded-full border border-border/50 px-4 py-1.5 font-mono text-xs uppercase tracking-widest text-text-secondary transition-colors duration-200 hover:text-text"
          >
            {tab.label} <span class="library-count" data-count={tab.type} />
          </button>
        ))
      }
    </div>

    {/* Search, grouping and narrowing. All static, so typing never loses its place. */}
    <div class="mt-6" id="library-controls">
      <label class="sr-only" for="library-search">Search the library</label>
      <input
        id="library-search"
        type="search"
        autocomplete="off"
        placeholder="Search titles, creators, lists and notes"
        class="w-full min-w-0 rounded-lg border border-border bg-bg px-3 py-2 text-sm text-text"
      />
      <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-text-secondary" id="library-menus" hidden>
        <span class="flex items-center gap-2" id="filter-group-wrap">
          <label for="filter-group">Group by</label>
          <select id="filter-group" class="library-select"></select>
        </span>
        <select data-facet="genre" class="library-select" aria-label="Narrow by genre" hidden></select>
        <select data-facet="language" class="library-select" aria-label="Narrow by language" hidden></select>
        <select data-facet="city" class="library-select" aria-label="Narrow by city" hidden></select>
        <select data-facet="kind" class="library-select" aria-label="Narrow by kind" hidden></select>
      </div>
    </div>

    <p class="mt-4 text-sm text-text-secondary" id="library-tabnote" hidden></p>

    {/* --- Want --- */}
    <div class="mt-10">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-display text-2xl font-bold">Want</h2>
        <span class="font-mono text-xs uppercase tracking-widest text-accent" id="want-count"></span>
      </div>
      <div
        class="mt-4 rounded-2xl border border-border/50 bg-surface/80 p-6 backdrop-blur-xl"
        style="border-top: 0.5px solid rgba(255,255,255,0.05);"
      >
        <div id="want" class="divide-y divide-border/50">
          <p class="font-mono text-sm text-text-secondary">Loading…</p>
        </div>
      </div>
    </div>

    {/* --- Done --- */}
    <div class="mt-16" id="done-section">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-display text-2xl font-bold">Done</h2>
        <span class="font-mono text-xs uppercase tracking-widest text-text-secondary" id="done-count"></span>
      </div>
      <div
        class="mt-4 rounded-2xl border border-border/50 bg-surface/80 p-6 backdrop-blur-xl"
        style="border-top: 0.5px solid rgba(255,255,255,0.05);"
      >
        <div id="done" class="divide-y divide-border/50">
          <p class="font-mono text-sm text-text-secondary">Loading…</p>
        </div>
      </div>
    </div>

    <div class="mt-10 font-mono text-xs text-text-secondary">
      <p id="library-note" aria-live="polite"></p>
      <p class="mt-2">
        Film and show details and posters come from
        <a href="https://www.themoviedb.org/" target="_blank" rel="noopener noreferrer" class="underline-offset-4 hover:text-text hover:underline">TMDB</a>;
        book covers from Open Library. This page is not endorsed or certified by TMDB.
      </p>
      <button type="button" id="signin-toggle" class="mt-2 underline-offset-4 hover:text-text hover:underline">
        Sign in to edit
      </button>
      <form id="signin-form" class="mt-3 flex max-w-sm gap-2" hidden>
        <label class="sr-only" for="signin-password">Password</label>
        <input
          id="signin-password"
          type="password"
          autocomplete="current-password"
          placeholder="Password"
          class="min-w-0 flex-1 rounded-lg border border-border bg-bg px-3 py-2 text-text"
        />
        <button type="submit" class="rounded-lg border border-border px-3 py-2 text-text hover:border-accent/50">
          Sign in
        </button>
      </form>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /*
    is:global because every row is built in JS after render, where Astro's scoped
    attributes never reach. Classes are `library-` prefixed to keep that safe.
  */
  .library-tab[aria-selected='true'] {
    color: var(--color-bg);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .library-count {
    opacity: 0.7;
  }

  .library-cover {
    width: 2.5rem;
    aspect-ratio: 2 / 3;
    flex: none;
    /* Without this the row stretches the cover to its own height and crops it. */
    align-self: flex-start;
    object-fit: cover;
    border-radius: 0.25rem;
    background: var(--color-border);
  }

  /* No cover: an empty plate the same size, so titles stay aligned down the list. */
  .library-cover[data-empty='true'] {
    border: 1px solid var(--color-border);
    background: transparent;
  }

  /* The title is a button so a row can be opened from the keyboard; it should read as text. */
  .library-title {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    overflow-wrap: anywhere;
    cursor: pointer;
  }

  .library-title:hover {
    color: var(--color-accent);
  }

  .library-detail {
    padding-bottom: 0.25rem;
  }

  .library-action {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    transition: border-color 200ms, color 200ms;
  }

  .library-action:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .library-action:disabled {
    opacity: 0.5;
  }

  /*
    A group is a <details>: the heading is its summary, so it takes focus, answers
    Enter and Space and reports its state without any script. The container query
    lets the covers give way before the label does.
  */
  .library-groupbox {
    container-type: inline-size;
  }

  .library-summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 0;
    cursor: pointer;
    list-style: none;
  }

  .library-summary::-webkit-details-marker {
    display: none;
  }

  .library-summary::before {
    content: '+';
    flex: none;
    width: 1ch;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    color: var(--color-accent);
  }

  .library-groupbox[open] > .library-summary::before {
    content: '\2212';
  }

  .library-headtext {
    flex: 1 1 auto;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .library-grouplabel {
    font-family: var(--font-display, inherit);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .library-groupcount,
  .library-groupaccount,
  .library-grouplink {
    margin-left: 0.6rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .library-groupcount,
  .library-grouplink {
    color: var(--color-accent);
  }

  .library-groupaccount {
    letter-spacing: 0;
    text-transform: none;
  }

  .library-grouplink:hover {
    text-decoration: underline;
  }

  .library-strip {
    display: flex;
    flex: 0 1 auto;
    gap: 0.25rem;
    min-width: 0;
    overflow: hidden;
    /* Shrinks long before the label does. */
    flex-shrink: 1000;
  }

  .library-thumb {
    width: 1.5rem;
    aspect-ratio: 2 / 3;
    flex: none;
    object-fit: cover;
    border-radius: 0.125rem;
    background: var(--color-border);
  }

  @container (max-width: 32rem) {
    .library-thumb:nth-child(n + 4) {
      display: none;
    }
  }

  @container (max-width: 22rem) {
    .library-strip {
      display: none;
    }
  }

  .library-rows {
    padding: 0.25rem 0 0.75rem;
  }

  .library-verdict {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.05rem 0.55rem;
    white-space: nowrap;
  }

  .library-verdict[data-verdict='use'] {
    color: var(--color-bg);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .library-verdict[data-verdict='try'] {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .library-select {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: inherit;
    padding: 0.2rem 0.5rem;
    max-width: 100%;
  }

  .library-summary:focus-visible,
  .library-title:focus-visible,
  #library-search:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>

<script>import '../scripts/instalibrary/page.ts';</script>
