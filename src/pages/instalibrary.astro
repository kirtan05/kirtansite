---
import BaseLayout from '../layouts/BaseLayout.astro';

// Data comes from the library Worker at /api/library, a Workers route on this
// hostname in front of Pages, beside spine's /api/reading. Fetched client-side
// because this page is prerendered and the list changes whenever a reel is filed.
const TABS = [
  { type: 'book', label: 'Books' },
  { type: 'film', label: 'Films' },
  { type: 'show', label: 'Shows' },
  { type: 'recipe', label: 'Recipes' },
  { type: 'music', label: 'Music' },
  { type: 'tool', label: 'Tools' },
  { type: 'place', label: 'Places' },
  { type: 'other', label: 'Other' },
];
---

<BaseLayout
  title="Instalibrary · Kirtan Jain"
  description="What I want to read, watch, cook, hear, try and visit, what I have finished, and the reel that put each one there."
>
  <section class="mx-auto max-w-4xl px-6 py-12 md:py-20" id="library">
    <div data-scroll-animate>
      <h1 class="font-display text-4xl font-bold md:text-5xl">Instalibrary</h1>
      <p class="mt-3 text-lg text-text-secondary">
        Things I mean to read, watch, cook, hear, try and visit. Most arrive from reels I send myself;
        each entry links back to the one that suggested it.
      </p>
    </div>

    <div class="mt-10 flex flex-wrap gap-2" role="tablist" aria-label="Kind" id="library-tabs">
      {
        TABS.map((tab) => (
          <button
            type="button"
            role="tab"
            data-type={tab.type}
            aria-selected="false"
            class="library-tab rounded-full border border-border/50 px-4 py-1.5 font-mono text-xs uppercase tracking-widest text-text-secondary transition-colors duration-200 hover:text-text"
          >
            {tab.label} <span class="library-count" data-count={tab.type} />
          </button>
        ))
      }
    </div>

    {/* Narrowing for the kinds that have something to narrow by: a city, a kind, a verdict. */}
    <div class="mt-6 flex flex-wrap gap-2 font-mono text-xs text-text-secondary" id="library-filters" hidden>
      <select id="filter-group" class="library-select" aria-label="Narrow by group"></select>
      <select id="filter-kind" class="library-select" aria-label="Narrow by kind"></select>
    </div>

    <p class="mt-4 text-sm text-text-secondary" id="library-tabnote" hidden></p>

    {/* --- Want --- */}
    <div class="mt-10">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-display text-2xl font-bold">Want</h2>
        <span class="font-mono text-xs uppercase tracking-widest text-accent" id="want-count"></span>
      </div>
      <div
        class="mt-4 rounded-2xl border border-border/50 bg-surface/80 p-6 backdrop-blur-xl"
        style="border-top: 0.5px solid rgba(255,255,255,0.05);"
      >
        <div id="want" class="divide-y divide-border/50">
          <p class="font-mono text-sm text-text-secondary">Loading…</p>
        </div>
      </div>
    </div>

    {/* --- Done --- */}
    <div class="mt-16">
      <div class="flex items-baseline justify-between gap-4">
        <h2 class="font-display text-2xl font-bold">Done</h2>
        <span class="font-mono text-xs uppercase tracking-widest text-text-secondary" id="done-count"></span>
      </div>
      <div
        class="mt-4 rounded-2xl border border-border/50 bg-surface/80 p-6 backdrop-blur-xl"
        style="border-top: 0.5px solid rgba(255,255,255,0.05);"
      >
        <div id="done" class="divide-y divide-border/50">
          <p class="font-mono text-sm text-text-secondary">Loading…</p>
        </div>
      </div>
    </div>

    <div class="mt-10 font-mono text-xs text-text-secondary">
      <p id="library-note" aria-live="polite"></p>
      <p class="mt-2">
        Film and show details and posters come from
        <a href="https://www.themoviedb.org/" target="_blank" rel="noopener noreferrer" class="underline-offset-4 hover:text-text hover:underline">TMDB</a>;
        book covers from Open Library. This page is not endorsed or certified by TMDB.
      </p>
      <button type="button" id="signin-toggle" class="mt-2 underline-offset-4 hover:text-text hover:underline">
        Sign in to edit
      </button>
      <form id="signin-form" class="mt-3 flex max-w-sm gap-2" hidden>
        <label class="sr-only" for="signin-password">Password</label>
        <input
          id="signin-password"
          type="password"
          autocomplete="current-password"
          placeholder="Password"
          class="min-w-0 flex-1 rounded-lg border border-border bg-bg px-3 py-2 text-text"
        />
        <button type="submit" class="rounded-lg border border-border px-3 py-2 text-text hover:border-accent/50">
          Sign in
        </button>
      </form>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /*
    is:global because every row is built in JS after render, where Astro's scoped
    attributes never reach. Classes are `library-` prefixed to keep that safe.
  */
  .library-tab[aria-selected='true'] {
    color: var(--color-bg);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .library-count {
    opacity: 0.7;
  }

  .library-cover {
    width: 3.25rem;
    aspect-ratio: 2 / 3;
    flex: none;
    /* Without this the row stretches the cover to its own height and crops it. */
    align-self: flex-start;
    object-fit: cover;
    border-radius: 0.375rem;
    background: var(--color-border);
  }

  /* No cover: an empty plate the same size, so titles stay aligned down the list. */
  .library-cover[data-empty='true'] {
    border: 1px solid var(--color-border);
    background: transparent;
  }

  .library-action {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    transition: border-color 200ms, color 200ms;
  }

  .library-action:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .library-action:disabled {
    opacity: 0.5;
  }

  .library-group {
    padding: 1.5rem 0 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .library-group:first-child {
    padding-top: 0;
  }

  .library-verdict {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.05rem 0.55rem;
    white-space: nowrap;
  }

  .library-verdict[data-verdict='use'] {
    color: var(--color-bg);
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .library-verdict[data-verdict='try'] {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .library-select {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: inherit;
    padding: 0.2rem 0.5rem;
  }
</style>

<script>import '../scripts/instalibrary/page.ts';</script>
