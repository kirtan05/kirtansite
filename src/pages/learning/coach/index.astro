---
export const prerender = false;

/**
 * The coach dashboard, which is really just a frame around the weekly brief.
 *
 * The staleness banner at the top is not decoration. Grading is the single
 * dependency of this entire system: if Saturday stops happening, every chart
 * below freezes while continuing to look authoritative, and a frozen chart
 * that looks live is worse than no chart. So the page says how old its inputs
 * are, prominently, before it says anything else — and drains of colour when
 * they are stale.
 */
import LearningLayout from '../../../layouts/LearningLayout.astro';
import { requireRole } from '../../../lib/learning/guard';
import { weeklyBrief } from '../../../lib/learning/engine';
import { breaks, coachVerifyQueue, unconfirmedTasks } from '../../../lib/learning/queries';
import { ago, daysBetween, human, today } from '../../../lib/learning/dates';

const gate = await requireRole(Astro, 'coach');
if (!gate.ok) return gate.response;
const { db } = gate.ctx;

const on = today();
const [brief, queue, allBreaks, claimed] = await Promise.all([
  weeklyBrief(db, on),
  coachVerifyQueue(db),
  breaks(db),
  unconfirmedTasks(db),
]);

const staleDays = brief.lastGraded ? daysBetween(brief.lastGraded, on) : null;
const stale = staleDays === null || staleDays > 14;
---

<LearningLayout title="Coach" role="coach" subtitle={human(on)} wide>
  {/* ── how much to trust anything below ─────────────────────────── */}
  <section
    class:list={[
      'rounded-2xl border p-5',
      stale ? 'border-red-500/30 bg-red-500/5' : 'border-border bg-surface',
    ]}
  >
    <p class="font-mono text-[11px] uppercase tracking-widest text-text-secondary">Freshness</p>
    {
      brief.lastGraded ? (
        <p class:list={['mt-2 text-lg', stale ? 'text-red-300' : 'text-text']}>
          Last graded <strong>{ago(brief.lastGraded, on)}</strong>
          <span class="text-text-secondary"> · {human(brief.lastGraded)}</span>
        </p>
      ) : (
        <p class="mt-2 text-lg text-red-300">Nothing has been graded yet.</p>
      )
    }
    {
      stale && (
        <p class="mt-2 text-sm text-red-300/80">
          Everything below is computed from attempts up to that date. Treat the topic map as out of
          date rather than as a measurement.
        </p>
      )
    }
    {
      brief.ungraded > 0 && (
        <p class="mt-3 text-sm">
          <a href="/learning/coach/grade" class="text-accent hover:underline">
            {brief.ungraded} evening{brief.ungraded === 1 ? '' : 's'} waiting to be graded →
          </a>
        </p>
      )
    }
    {
      brief.onBreak && (
        <p class="mt-3 rounded-lg border border-border/60 px-3 py-2 font-mono text-xs text-text-secondary">
          On a declared break: {brief.onBreak}. Gaps in this period are not counted as missed.
        </p>
      )
    }
  </section>

  {/* ── the brief ────────────────────────────────────────────────── */}
  <section class="mt-8 rounded-2xl border border-border bg-surface p-5">
    <h2 class="font-display text-lg font-bold">
      {brief.nextSession ? `Next: sheet ${brief.nextSession.seq} — ${brief.nextSession.title}` : 'No sheet queued'}
    </h2>
    {
      brief.nextSession?.on_date && (
        <p class="mt-1 font-mono text-xs text-text-secondary">planned for {human(brief.nextSession.on_date)}</p>
      )
    }

    <dl class="mt-5 space-y-5 text-sm">
      <div>
        <dt class="font-mono text-[11px] uppercase tracking-widest text-text-secondary">Still open</dt>
        <dd class="mt-2">
          {
            brief.carryovers.length === 0 ? (
              <span class="text-text-secondary">nothing carried over</span>
            ) : (
              <ul class="flex flex-wrap gap-2">
                {brief.carryovers.map((c) => (
                  <li class="rounded-lg border border-border px-3 py-1.5 font-mono text-xs">
                    S{c.seq}·{c.ref}
                    <span class="ml-2 text-text-secondary">{c.weeks}w</span>
                  </li>
                ))}
              </ul>
            )
          }
        </dd>
      </div>

      <div>
        <dt class="font-mono text-[11px] uppercase tracking-widest text-text-secondary">
          Re-tests due — put these on the sheet
        </dt>
        <dd class="mt-2">
          {
            brief.retests.length === 0 ? (
              <span class="text-text-secondary">none due in the next week</span>
            ) : (
              <ul class="space-y-1">
                {brief.retests.map((r) => (
                  <li class="flex flex-wrap items-baseline gap-x-3 rounded-lg border border-border px-3 py-2">
                    <span class="font-mono text-xs">
                      S{r.seq}·{r.ref}
                    </span>
                    <span class="text-xs text-text-secondary">{r.topics || 'untagged'}</span>
                    <span class="ml-auto font-mono text-[11px] text-text-secondary">
                      stage {r.stage + 1} · due {human(r.due_on)}
                    </span>
                  </li>
                ))}
              </ul>
            )
          }
        </dd>
      </div>

      <div>
        <dt class="font-mono text-[11px] uppercase tracking-widest text-text-secondary">Watch</dt>
        <dd class="mt-2">
          {
            brief.watch.length === 0 ? (
              <span class="text-text-secondary">nothing flagged</span>
            ) : (
              <ul class="space-y-1">
                {brief.watch.map((t) => (
                  <li class="rounded-lg border border-border px-3 py-2">
                    <span class="font-medium">{t.name}</span>
                    <span class="ml-2 font-mono text-[11px] uppercase tracking-wider text-accent">{t.state}</span>
                    <div class="mt-0.5 text-xs text-text-secondary">{t.summary}</div>
                  </li>
                ))}
              </ul>
            )
          }
        </dd>
      </div>

      <div>
        <dt class="font-mono text-[11px] uppercase tracking-widest text-text-secondary">Computer track</dt>
        <dd class="mt-2 text-text-secondary">
          {
            brief.typing.latest === null ? (
              'no typing measurement recorded yet'
            ) : (
              <>
                typing <span class="text-text">{brief.typing.latest} wpm</span>
                {brief.typing.delta !== null && brief.typing.weeks
                  ? `, ${brief.typing.delta >= 0 ? '+' : ''}${brief.typing.delta} in ${brief.typing.weeks} weeks`
                  : ''}
              </>
            )
          }
        </dd>
      </div>
    </dl>
  </section>

  {/* ── the queue ────────────────────────────────────────────────── */}
  <section class="mt-8">
    <h2 class="font-mono text-[11px] uppercase tracking-widest text-text-secondary">To grade</h2>
    {
      queue.length === 0 ? (
        <p class="mt-2 text-sm text-text-secondary">Nothing waiting.</p>
      ) : (
        <ul class="mt-3 space-y-2">
          {queue.map((e: any) => (
            <li class="flex items-center justify-between gap-3 rounded-xl border border-border bg-surface px-4 py-3">
              <div>
                <div class="text-sm">
                  Sheet {e.seq} — {e.title}
                </div>
                <div class="font-mono text-[11px] text-text-secondary">
                  {human(e.on_date)} · {e.ungraded} ungraded
                  {!e.closed_at && ' · still open'}
                </div>
              </div>
              <a
                href={`/learning/coach/grade?entry=${e.id}`}
                class="tap shrink-0 rounded-lg border border-accent/30 bg-accent/10 px-3 py-2 text-xs text-accent"
              >
                Grade
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {/* ── the track that gets skipped ──────────────────────────────── */}
  {
    claimed.length > 0 && (
      <section class="mt-8">
        <h2 class="font-mono text-[11px] uppercase tracking-widest text-text-secondary">
          Computer track — he says he did these
        </h2>
        <p class="mt-2 text-sm text-text-secondary">
          Ask him to show you, then confirm. The ones with no file attached are the ones worth asking
          about — they are the rungs it is easiest to skip.
        </p>
        <ul class="mt-3 space-y-2">
          {claimed.map((t: any) => (
            <li class="flex flex-wrap items-center gap-3 rounded-xl border border-border bg-surface px-4 py-3">
              <div class="min-w-0 flex-1">
                <div class="text-sm">{t.title}</div>
                <div class="font-mono text-[10px] uppercase tracking-wider text-text-secondary">
                  {t.session_title} · claimed {human(t.on_date)}
                  {t.evidence_kind !== 'none' && !t.evidence_upload_id && ' · no file attached'}
                </div>
              </div>
              {t.evidence_upload_id && (
                <a href={`/learning/api/file/${t.evidence_upload_id}`} class="font-mono text-[11px] text-accent">
                  see it
                </a>
              )}
              {['done', 'skipped'].map((state) => (
                <form method="post" action="/learning/api/task">
                  <input type="hidden" name="task_id" value={t.id} />
                  <input type="hidden" name="state" value={state} />
                  <button
                    class:list={[
                      'tap rounded-lg border px-3 py-2 text-xs',
                      state === 'done'
                        ? 'border-emerald-500/40 text-emerald-400'
                        : 'border-border text-text-secondary',
                    ]}
                  >
                    {state === 'done' ? 'confirm' : 'skip'}
                  </button>
                </form>
              ))}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ── housekeeping ─────────────────────────────────────────────── */}
  <section class="mt-12 grid gap-4 md:grid-cols-2">
    <form method="post" action="/learning/api/grade" class="rounded-2xl border border-border bg-surface p-5">
      <input type="hidden" name="action" value="break" />
      <h3 class="font-mono text-[11px] uppercase tracking-widest text-text-secondary">Declare a break</h3>
      <p class="mt-2 text-xs text-text-secondary">
        Exams, travel, Diwali. A declared break is not a missed week and nothing derived will score it
        as one.
      </p>
      <div class="mt-3 grid grid-cols-2 gap-2">
        <input type="date" name="start_on" required class="tap rounded-lg border border-border bg-bg px-3 py-2 text-sm" />
        <input type="date" name="end_on" required class="tap rounded-lg border border-border bg-bg px-3 py-2 text-sm" />
      </div>
      <input
        type="text"
        name="reason"
        required
        placeholder="reason"
        class="tap mt-2 w-full rounded-lg border border-border bg-bg px-3 py-2 text-sm"
      />
      <button class="tap mt-3 w-full rounded-lg border border-border px-3 py-2 text-sm hover:border-accent/40 hover:text-accent">
        Record it
      </button>
      {
        allBreaks.length > 0 && (
          <ul class="mt-3 space-y-1 font-mono text-[11px] text-text-secondary">
            {allBreaks.map((b) => (
              <li>
                {human(b.start_on)} – {human(b.end_on)} · {b.reason}
              </li>
            ))}
          </ul>
        )
      }
    </form>

    <form method="post" action="/learning/api/grade" class="rounded-2xl border border-border bg-surface p-5">
      <input type="hidden" name="action" value="measure" />
      <h3 class="font-mono text-[11px] uppercase tracking-widest text-text-secondary">Record a measurement</h3>
      <p class="mt-2 text-xs text-text-secondary">
        Typing speed from the screenshot he uploaded — measured, not claimed.
      </p>
      <div class="mt-3 grid grid-cols-2 gap-2">
        <select name="metric" class="tap rounded-lg border border-border bg-bg px-3 py-2 text-sm">
          <option value="typing_wpm">typing wpm</option>
          <option value="typing_accuracy">typing accuracy %</option>
        </select>
        <input
          type="number"
          step="0.1"
          name="value"
          required
          placeholder="value"
          class="tap rounded-lg border border-border bg-bg px-3 py-2 text-sm"
        />
      </div>
      <input type="date" name="on_date" value={on} class="tap mt-2 w-full rounded-lg border border-border bg-bg px-3 py-2 text-sm" />
      <button class="tap mt-3 w-full rounded-lg border border-border px-3 py-2 text-sm hover:border-accent/40 hover:text-accent">
        Save
      </button>
    </form>
  </section>

  <section class="mt-8 flex flex-wrap items-center gap-4 border-t border-border/60 pt-6">
    <a href="/learning/api/export" class="font-mono text-[11px] uppercase tracking-widest text-text-secondary hover:text-accent">
      download everything (json)
    </a>
    <form method="post" action="/learning/api/grade">
      <input type="hidden" name="action" value="signout_everywhere" />
      <button class="font-mono text-[11px] uppercase tracking-widest text-text-secondary hover:text-red-400">
        sign coach out everywhere
      </button>
    </form>
  </section>
</LearningLayout>
