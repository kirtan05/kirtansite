---
export const prerender = false;

/**
 * The topic map.
 *
 * Every tile shows raw counts. None of them shows a percentage, because with
 * four or five observations a percentage is a confident-looking random number,
 * and this page is read by the one person whose attention it is meant to
 * direct. Below MIN_N the tile says "too few to call" and means it.
 *
 * The caption at the bottom is not boilerplate. Tagging a problem with two or
 * three topics is the right call for a one-parent system, but it does blur the
 * signal, and a single bad Saturday genuinely can look like three subjects
 * collapsing at once.
 */
import LearningLayout from '../../../layouts/LearningLayout.astro';
import { requireRole } from '../../../lib/learning/guard';
import { MIN_N, topicMap, type TopicState } from '../../../lib/learning/engine';
import { ago, human, today } from '../../../lib/learning/dates';

const gate = await requireRole(Astro, 'coach');
if (!gate.ok) return gate.response;

const on = today();
const topics = await topicMap(gate.ctx.db, on);

const STYLE: Record<TopicState, string> = {
  strong: 'border-emerald-500/30 bg-emerald-500/5',
  shaky: 'border-amber-500/30 bg-amber-500/5',
  blocked: 'border-red-500/30 bg-red-500/5',
  stale: 'border-sky-500/30 bg-sky-500/5',
  too_few: 'border-border bg-surface',
  untouched: 'border-border/40 bg-transparent',
};

const LABEL: Record<TopicState, string> = {
  strong: 'strong',
  shaky: 'shaky',
  blocked: 'blocked',
  stale: 'stale',
  too_few: 'too few',
  untouched: 'untouched',
};

const order: TopicState[] = ['blocked', 'shaky', 'stale', 'strong', 'too_few', 'untouched'];
const sorted = [...topics].sort((a, b) => order.indexOf(a.state) - order.indexOf(b.state));
const graded = topics.filter((t) => t.n_first + t.n_retest > 0).length;
---

<LearningLayout title="Topics" role="coach" subtitle={`${graded} of ${topics.length} touched · ${human(on)}`} wide>
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      sorted.map((t) => (
        <div class:list={['rounded-xl border p-4', STYLE[t.state]]}>
          <div class="flex items-baseline justify-between gap-2">
            <h2 class="font-medium">{t.name}</h2>
            <span class="font-mono text-[10px] uppercase tracking-widest text-text-secondary">{LABEL[t.state]}</span>
          </div>
          <p class="mt-2 text-xs text-text-secondary">{t.summary}</p>
          {t.last_seen && (
            <p class="mt-2 font-mono text-[10px] text-text-secondary">last seen {ago(t.last_seen, on)}</p>
          )}
          {t.n_first + t.n_retest > 0 && (
            <dl class="mt-3 grid grid-cols-4 gap-1 border-t border-border/40 pt-2 font-mono text-[10px] text-text-secondary">
              <div><dt>alone</dt><dd class="text-text">{t.first_alone}</dd></div>
              <div><dt>hint</dt><dd class="text-text">{t.first_hint}</dd></div>
              <div><dt>stuck</dt><dd class="text-text">{t.first_stuck}</dd></div>
              <div><dt>re-test</dt><dd class="text-text">{t.retest_pass}/{t.n_retest}</dd></div>
            </dl>
          )}
        </div>
      ))
    }
  </div>

  <section class="mt-10 space-y-3 border-t border-border/60 pt-6 text-sm text-text-secondary">
    <p>
      <strong class="text-text">How to read this.</strong> These are prompts for your attention, not
      measurements. A topic is only classified once it has {MIN_N} graded first attempts; below that it
      says <em>too few</em> rather than guessing, and that is the honest answer for most of the first
      term.
    </p>
    <p>
      Problems are tagged with two or three topics each, which is the right trade for a system one
      person maintains — but it means a single bad evening can light up three tiles at once. Before
      concluding that a subject is failing, open the evening and look at what actually happened.
    </p>
    <p>
      <strong class="text-text">Retention is the only column that can see forgetting</strong>, and it
      stays thin for months. It says nothing trustworthy until there have been re-tests at the second
      stage — roughly three months in. Do not tune anything on three data points.
    </p>
  </section>
</LearningLayout>
