---
export const prerender = false;

/**
 * Everything, by date.
 *
 * Both roles get this page, and both get the same rows — this is the part of
 * the system that is meant to still be worth opening in three years, and a
 * record he is not allowed to read is not his record.
 *
 * Breaks appear in the timeline as declared breaks, not as holes. A year from
 * now, "exams, 2 weeks" is a fact; an unexplained gap is a reproach.
 */
import LearningLayout from '../../layouts/LearningLayout.astro';
import { requireRole } from '../../lib/learning/guard';
import { breaks, historyRows } from '../../lib/learning/queries';
import { human, today, weekday } from '../../lib/learning/dates';

const gate = await requireRole(Astro, 'any');
if (!gate.ok) return gate.response;
const { db, role } = gate.ctx;

const [rows, allBreaks] = await Promise.all([historyRows(db, 200), breaks(db)]);

// Interleave evenings and breaks into one reverse-chronological list.
type Item =
  | { at: string; type: 'entry'; row: any }
  | { at: string; type: 'break'; row: { start_on: string; end_on: string; reason: string } };

const items: Item[] = [
  ...rows.map((r: any) => ({ at: r.on_date as string, type: 'entry' as const, row: r })),
  ...allBreaks.map((b) => ({ at: b.start_on, type: 'break' as const, row: b })),
].sort((a, b) => (a.at < b.at ? 1 : -1));

const totalMinutes = rows.reduce((n: number, r: any) => n + (r.minutes ?? 0), 0);
---

<LearningLayout
  title={role === 'coach' ? 'History' : 'Everything'}
  role={role}
  subtitle={`${rows.length} evening${rows.length === 1 ? '' : 's'}${totalMinutes ? ` · ${Math.round(totalMinutes / 60)} hours recorded` : ''}`}
  wide
>
  {
    items.length === 0 ? (
      <p class="rounded-xl border border-border bg-surface p-5 text-text-secondary">
        Nothing here yet. It starts the first time a sheet is photographed.
      </p>
    ) : (
      <ol class="space-y-3">
        {items.map((item) =>
          item.type === 'break' ? (
            <li class="rounded-xl border border-dashed border-border px-4 py-3">
              <span class="font-mono text-[11px] uppercase tracking-widest text-text-secondary">break</span>
              <span class="ml-3 text-sm text-text-secondary">
                {human(item.row.start_on)} – {human(item.row.end_on)} · {item.row.reason}
              </span>
            </li>
          ) : (
            <li class="rounded-xl border border-border bg-surface px-4 py-4">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <a href={`/learning/session/${item.row.seq}`} class="font-medium hover:text-accent">
                  Sheet {item.row.seq} — {item.row.title}
                </a>
                <span class="font-mono text-[11px] text-text-secondary">
                  {weekday(item.row.on_date)}, {human(item.row.on_date)}
                </span>
              </div>

              <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 font-mono text-[11px] text-text-secondary">
                <span>
                  {item.row.solved}/{item.row.attempts} solved
                </span>
                {item.row.minutes && <span>{item.row.minutes} min</span>}
                {item.row.uploads > 0 && <span>{item.row.uploads} kept</span>}
                {!item.row.closed_at && <span class="text-accent">still open</span>}
                {item.row.closed_at && !item.row.verified_at && <span class="text-amber-400">not graded</span>}
              </div>

              {item.row.kid_note && <p class="mt-3 text-sm text-text-secondary">"{item.row.kid_note}"</p>}
            </li>
          ),
        )}
      </ol>
    )
  }
</LearningLayout>
