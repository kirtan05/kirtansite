---
export const prerender = false;

/**
 * One sheet, every time it has been worked on.
 *
 * A problem is not finished when it is first attempted — it comes back as a
 * carry-over and again as a re-test, sometimes over two years. This page is
 * the only view where that whole arc is visible for a single sheet, so it
 * lists attempts per problem rather than per evening.
 *
 * Answers are shown only to the coach, and the query that fetches them is a
 * different function from the one the boy's view uses.
 */
import LearningLayout from '../../../layouts/LearningLayout.astro';
import { requireRole } from '../../../lib/learning/guard';
import { coachProblemsFor, problemsFor, sessionBySeq } from '../../../lib/learning/queries';
import { human } from '../../../lib/learning/dates';

const gate = await requireRole(Astro, 'any');
if (!gate.ok) return gate.response;
const { db, role } = gate.ctx;

const seq = Number(Astro.params.seq);
if (!Number.isInteger(seq) || seq < 1) return new Response('Not found', { status: 404 });

const session = await sessionBySeq(db, seq);
if (!session) return new Response('Not found', { status: 404 });

const problems = role === 'coach' ? await coachProblemsFor(db, session.id) : await problemsFor(db, session.id);

const attemptRows = await db
  .prepare(
    `SELECT a.problem_id, a.kid_mark, a.outcome, a.kind, a.voided_at, e.on_date
       FROM attempt a JOIN entry e ON e.id = a.entry_id
      WHERE a.problem_id IN (SELECT id FROM problem WHERE session_id = ?)
      ORDER BY e.on_date`,
  )
  .bind(session.id)
  .all<{ problem_id: string; kid_mark: string | null; outcome: string | null; kind: string; voided_at: string | null; on_date: string }>();

const stateRows = await db
  .prepare(
    `SELECT problem_id, state, since, reason FROM problem_state
      WHERE problem_id IN (SELECT id FROM problem WHERE session_id = ?)`,
  )
  .bind(session.id)
  .all<{ problem_id: string; state: string; since: string; reason: string | null }>();

const byProblem = new Map<string, typeof attemptRows.results>();
for (const a of attemptRows.results ?? []) {
  if (!byProblem.has(a.problem_id)) byProblem.set(a.problem_id, [] as any);
  byProblem.get(a.problem_id)!.push(a);
}
const stateOf = new Map((stateRows.results ?? []).map((s) => [s.problem_id, s]));

const OUTCOME_WORD: Record<string, string> = {
  solved_alone: 'alone',
  solved_with_hint: 'with a hint',
  stuck: 'stuck',
  not_attempted: 'skipped',
};
const STATE_WORD: Record<string, string> = { open: 'still alive', solved: 'cracked', retired: 'retired' };
---

<LearningLayout title={`Sheet ${session.seq}`} role={role} subtitle={session.title} wide>
  {
    session.sheet_slug && (
      <p class="mb-6 flex flex-wrap gap-4 font-mono text-[11px] uppercase tracking-widest">
        <a href={`/learning/sheet/${session.sheet_slug}-STUDENT.pdf`} class="text-accent hover:underline">
          the sheet ↗
        </a>
        {role === 'coach' && (
          <a href={`/learning/sheet/${session.sheet_slug}-COACH.pdf`} class="text-text-secondary hover:text-text">
            coach notes ↗
          </a>
        )}
      </p>
    )
  }

  <ul class="space-y-3">
    {
      problems.map((p: any) => {
        const history = byProblem.get(p.id) ?? [];
        const st = stateOf.get(p.id);
        return (
          <li class="rounded-xl border border-border bg-surface p-4">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class="font-mono text-sm">{p.ref}</span>
              {p.label && <span class="text-sm text-text-secondary">{p.label}</span>}
              {p.kind === 'starred' && <span class="text-accent">*</span>}
              {st && (
                <span
                  class:list={[
                    'ml-auto font-mono text-[10px] uppercase tracking-widest',
                    st.state === 'solved' ? 'text-emerald-400' : st.state === 'open' ? 'text-accent' : 'text-text-secondary',
                  ]}
                >
                  {STATE_WORD[st.state]}
                </span>
              )}
            </div>

            {role === 'coach' && p.answer && (
              <p class="mt-2 font-mono text-xs text-text-secondary">answer: {p.answer}</p>
            )}
            {role === 'coach' && p.topics && (
              <p class="mt-1 font-mono text-[10px] uppercase tracking-wider text-text-secondary">{p.topics}</p>
            )}

            {history.length > 0 && (
              <ol class="mt-3 space-y-1 border-t border-border/40 pt-2">
                {history.map((a: any) => (
                  <li
                    class:list={[
                      'flex flex-wrap items-baseline gap-x-3 font-mono text-[11px]',
                      a.voided_at ? 'text-text-secondary line-through' : 'text-text-secondary',
                    ]}
                  >
                    <span>{human(a.on_date)}</span>
                    {a.kind !== 'first' && <span class="text-accent">{a.kind}</span>}
                    <span class="text-text">{a.outcome ? OUTCOME_WORD[a.outcome] : 'not graded'}</span>
                    {a.kid_mark && <span>· he said {a.kid_mark.replace('_', ' ')}</span>}
                  </li>
                ))}
              </ol>
            )}

            {st?.reason && <p class="mt-2 text-xs text-text-secondary">{st.reason}</p>}

            {role === 'coach' && st?.state === 'open' && (
              <form method="post" action="/learning/api/grade" class="mt-3 flex gap-2">
                <input type="hidden" name="action" value="retire" />
                <input type="hidden" name="problem_id" value={p.id} />
                <input
                  type="text"
                  name="reason"
                  required
                  placeholder="retire this problem, and say why"
                  class="flex-1 rounded-lg border border-border bg-bg px-3 py-2 text-xs"
                />
                <button class="rounded-lg border border-border px-3 py-2 font-mono text-[10px] uppercase tracking-widest text-text-secondary hover:text-red-400">
                  retire
                </button>
              </form>
            )}
          </li>
        );
      })
    }
  </ul>
</LearningLayout>
