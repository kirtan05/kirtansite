---
export const prerender = false;

import {
  COOKIE,
  cookieOptions,
  currentEpoch,
  env as getEnv,
  hostAllowed,
  issueCookie,
  readCookie,
  verifyPassword,
} from '../../lib/netmon/guard';

if (!hostAllowed(Astro)) return new Response('Not found', { status: 404 });

const env = getEnv(Astro);
const db = env.NETMON_DB;
const secret = env.NETMON_COOKIE_KEY;
if (!db || !secret) return new Response('/net is not configured on this deployment.', { status: 503 });

let signedIn = false;
const existing = await readCookie(secret, Astro.cookies.get(COOKIE)?.value);
if (existing && existing.e === (await currentEpoch(db))) signedIn = true;

let error: string | null = null;
if (!signedIn && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (await verifyPassword(env.NETMON_PW, String(form.get('password') ?? ''))) {
    const { value, maxAge } = await issueCookie(secret, await currentEpoch(db));
    Astro.cookies.set(COOKIE, value, cookieOptions(maxAge));
    return Astro.redirect('/net');
  }
  error = 'Wrong password. Try again.';
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="same-origin" />
    <meta name="color-scheme" content="light dark" />
    <title>net</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Literata:opsz,wght@7..72,400;7..72,500;7..72,600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --paper: #f3f4f7;
        --card: #ffffff;
        --card-subtle: #f7f8fb;
        --ink: #18204a;
        --ink-2: #545c80;
        --rule: #d7dbe6;
        --ok: #1b8454;
        --warn: #c27803;
        --bad: #bf3a31;
        --accent: #2f55d4;
        --ok-bg: rgba(27, 132, 84, 0.11);
        --warn-bg: rgba(194, 120, 3, 0.12);
        --bad-bg: rgba(191, 58, 49, 0.11);
        --accent-bg: rgba(47, 85, 212, 0.1);
        --muted-bg: rgba(84, 92, 128, 0.1);
        --shadow-sm: 0 1px 2px rgba(24, 32, 74, 0.05);
        --shadow-lg: 0 20px 50px rgba(14, 19, 38, 0.18);
        --font-serif: 'Literata', Georgia, Cambria, serif;
        --font-sans: 'Instrument Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-mono: ui-monospace, 'SFMono-Regular', Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
        --radius: 10px;
        --radius-sm: 6px;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --paper: #0e1326;
          --card: #151c36;
          --card-subtle: #11172d;
          --ink: #e8ebf7;
          --ink-2: #94a0c8;
          --rule: #263058;
          --ok: #4fd193;
          --warn: #f0b44c;
          --bad: #f07a70;
          --accent: #7c9bff;
          --ok-bg: rgba(79, 209, 147, 0.14);
          --warn-bg: rgba(240, 180, 76, 0.15);
          --bad-bg: rgba(240, 122, 112, 0.15);
          --accent-bg: rgba(124, 155, 255, 0.15);
          --muted-bg: rgba(148, 160, 200, 0.13);
          --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.25);
          --shadow-lg: 0 24px 60px rgba(0, 0, 0, 0.55);
        }
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--font-sans);
        font-size: 14px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      button,
      input,
      select {
        font: inherit;
        color: inherit;
      }

      .mono {
        font-family: var(--font-mono);
        font-variant-numeric: tabular-nums;
      }

      .num {
        font-variant-numeric: tabular-nums;
      }

      .muted {
        color: var(--ink-2);
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      /* ── Auth Gate ─────────────────────────────────────────────── */
      .gate-wrap {
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 1.5rem;
      }

      .gate-card {
        width: 100%;
        max-width: 22.5rem;
        background: var(--card);
        border: 1px solid var(--rule);
        border-radius: 14px;
        padding: 2rem 1.75rem;
        box-shadow: var(--shadow-sm);
      }

      .gate-brand {
        font-family: var(--font-serif);
        font-size: 1.75rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin: 0 0 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .gate-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        background: var(--accent);
        display: inline-block;
      }

      .gate-sub {
        margin: 0 0 1.5rem;
        color: var(--ink-2);
        font-size: 0.875rem;
      }

      .gate-form {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .gate-error {
        margin: 0 0 0.25rem;
        padding: 0.55rem 0.75rem;
        border-radius: var(--radius-sm);
        background: var(--bad-bg);
        color: var(--bad);
        font-size: 0.85rem;
        font-weight: 500;
      }

      /* ── Inputs & Buttons ─────────────────────────────────────── */
      .input,
      .select {
        background: var(--card);
        border: 1px solid var(--rule);
        border-radius: var(--radius-sm);
        padding: 0.45rem 0.7rem;
        font-size: 0.875rem;
        color: var(--ink);
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
      }

      .input:focus,
      .select:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-bg);
      }

      .input::placeholder {
        color: var(--ink-2);
        opacity: 0.75;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.45rem 0.85rem;
        border-radius: var(--radius-sm);
        border: 1px solid var(--rule);
        background: var(--card);
        color: var(--ink);
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
        transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
      }

      .btn:hover:not(:disabled) {
        background: var(--card-subtle);
        border-color: var(--ink-2);
      }

      .btn:disabled {
        opacity: 0.55;
        cursor: not-allowed;
      }

      .btn-primary {
        background: var(--accent);
        border-color: var(--accent);
        color: #ffffff;
      }

      @media (prefers-color-scheme: dark) {
        .btn-primary {
          color: #0b1024;
          font-weight: 600;
        }
      }

      .btn-primary:hover:not(:disabled) {
        filter: brightness(1.06);
        background: var(--accent);
        border-color: var(--accent);
      }

      .btn-ghost {
        background: transparent;
        border-color: transparent;
        color: var(--ink-2);
      }

      .btn-ghost:hover:not(:disabled) {
        background: var(--muted-bg);
        border-color: transparent;
        color: var(--ink);
      }

      .btn-danger-ghost {
        background: transparent;
        border-color: var(--rule);
        color: var(--bad);
      }

      .btn-danger-ghost:hover:not(:disabled) {
        background: var(--bad-bg);
        border-color: var(--bad);
      }

      .btn-sm {
        padding: 0.3rem 0.6rem;
        font-size: 0.8rem;
      }

      .btn-active {
        border-color: var(--ok);
        background: var(--ok-bg);
        color: var(--ok);
      }

      /* ── App Shell ────────────────────────────────────────────── */
      .app {
        max-width: 76rem;
        margin: 0 auto;
        padding: 1rem 1.25rem 3rem;
      }

      @media (max-width: 640px) {
        .app {
          padding: 0.75rem 0.85rem 2.5rem;
        }
      }

      /* Header */
      .topbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem 1rem;
        padding-bottom: 0.9rem;
        border-bottom: 1px solid var(--rule);
      }

      .topbar-left {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .brand {
        font-family: var(--font-serif);
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin: 0;
        line-height: 1.1;
      }

      .topbar-controls {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      /* Status pill */
      .pill {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.25rem 0.65rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 500;
        border: 1px solid var(--rule);
        background: var(--card);
        color: var(--ink-2);
      }

      .pill .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--ink-2);
        flex-shrink: 0;
      }

      .pill.ok {
        border-color: transparent;
        background: var(--ok-bg);
        color: var(--ok);
      }

      .pill.ok .dot {
        background: var(--ok);
        box-shadow: 0 0 0 0 var(--ok);
        animation: pulse-dot 2s infinite;
      }

      .pill.warn {
        border-color: transparent;
        background: var(--warn-bg);
        color: var(--warn);
      }

      .pill.warn .dot {
        background: var(--warn);
      }

      .pill.muted {
        background: var(--muted-bg);
        border-color: transparent;
        color: var(--ink-2);
      }

      @keyframes pulse-dot {
        0% {
          box-shadow: 0 0 0 0 rgba(27, 132, 84, 0.5);
        }
        70% {
          box-shadow: 0 0 0 6px rgba(27, 132, 84, 0);
        }
        100% {
          box-shadow: 0 0 0 0 rgba(27, 132, 84, 0);
        }
      }

      /* Tabs */
      .tabs {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        margin: 0.85rem 0 1.15rem;
        overflow-x: auto;
        scrollbar-width: none;
        border-bottom: 1px solid var(--rule);
      }

      .tabs::-webkit-scrollbar {
        display: none;
      }

      .tab {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.6rem 0.9rem;
        border: none;
        border-bottom: 2px solid transparent;
        background: transparent;
        color: var(--ink-2);
        font-size: 0.88rem;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
        margin-bottom: -1px;
        transition: color 0.15s ease, border-color 0.15s ease;
      }

      .tab:hover {
        color: var(--ink);
      }

      .tab[aria-selected='true'] {
        color: var(--ink);
        border-bottom-color: var(--accent);
        font-weight: 600;
      }

      .tab-badge {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-variant-numeric: tabular-nums;
        padding: 0.08rem 0.42rem;
        border-radius: 999px;
        background: var(--muted-bg);
        color: var(--ink-2);
      }

      .tab[aria-selected='true'] .tab-badge {
        background: var(--accent-bg);
        color: var(--accent);
      }

      .panel[hidden] {
        display: none;
      }

      /* Banner */
      .banner {
        margin-bottom: 1rem;
        padding: 0.65rem 0.9rem;
        border-radius: var(--radius-sm);
        background: var(--bad-bg);
        color: var(--bad);
        border: 1px solid var(--bad);
        font-size: 0.85rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
      }

      .banner[hidden] {
        display: none;
      }

      /* ── Cards & Layout Grids ─────────────────────────────────── */
      .kpi-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 0.75rem;
        margin-bottom: 1rem;
      }

      @media (max-width: 1024px) {
        .kpi-grid {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      @media (max-width: 640px) {
        .kpi-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      .kpi {
        background: var(--card);
        border: 1px solid var(--rule);
        border-radius: var(--radius);
        padding: 0.9rem 1rem;
        box-shadow: var(--shadow-sm);
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
        min-width: 0;
      }

      .kpi-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--ink-2);
      }

      .kpi-value {
        font-family: var(--font-mono);
        font-variant-numeric: tabular-nums;
        font-size: 1.35rem;
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.02em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .kpi-value-pair {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.35rem 0.65rem;
        font-family: var(--font-mono);
        font-variant-numeric: tabular-nums;
        font-size: 1.05rem;
        font-weight: 600;
        line-height: 1.3;
      }

      .kpi-sub {
        font-size: 0.78rem;
        color: var(--ink-2);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .grid-2 {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
      }

      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
        margin-bottom: 1rem;
      }

      @media (max-width: 900px) {
        .grid-2,
        .grid-3 {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      .card {
        background: var(--card);
        border: 1px solid var(--rule);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
        margin-bottom: 1rem;
        min-width: 0;
      }

      .grid-2 .card,
      .grid-3 .card {
        margin-bottom: 0;
      }

      .card-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem 1rem;
        padding: 0.8rem 1rem;
        border-bottom: 1px solid var(--rule);
      }

      .card-title {
        font-family: var(--font-serif);
        font-size: 1.02rem;
        font-weight: 600;
        margin: 0;
        letter-spacing: -0.01em;
      }

      .card-meta {
        font-size: 0.78rem;
        color: var(--ink-2);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .card-body {
        padding: 0.9rem 1rem;
      }

      .card-body-flush {
        padding: 0;
      }

      /* ── Chart ────────────────────────────────────────────────── */
      .chart-wrap {
        position: relative;
        width: 100%;
      }

      .chart-svg {
        display: block;
        width: 100%;
        height: auto;
        max-height: 250px;
        user-select: none;
        touch-action: pan-y;
      }

      .chart-legend {
        display: inline-flex;
        align-items: center;
        gap: 0.85rem;
        font-size: 0.78rem;
      }

      .legend-item {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
      }

      .legend-swatch {
        width: 10px;
        height: 3px;
        border-radius: 2px;
        display: inline-block;
      }

      .chart-tooltip {
        position: absolute;
        top: 8px;
        right: 12px;
        pointer-events: none;
        background: var(--card);
        border: 1px solid var(--rule);
        border-radius: var(--radius-sm);
        padding: 0.35rem 0.6rem;
        font-size: 0.75rem;
        box-shadow: var(--shadow-sm);
        display: flex;
        gap: 0.65rem;
        align-items: center;
        flex-wrap: wrap;
      }

      .chart-tooltip[hidden] {
        display: none;
      }

      /* ── Badges & Dots ────────────────────────────────────────── */
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.14rem 0.5rem;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.01em;
        white-space: nowrap;
      }

      .badge-ok {
        background: var(--ok-bg);
        color: var(--ok);
      }

      .badge-warn {
        background: var(--warn-bg);
        color: var(--warn);
      }

      .badge-bad {
        background: var(--bad-bg);
        color: var(--bad);
      }

      .badge-accent {
        background: var(--accent-bg);
        color: var(--accent);
      }

      .badge-muted {
        background: var(--muted-bg);
        color: var(--ink-2);
      }

      .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
      }

      .status-dot.online {
        background: var(--ok);
      }

      .status-dot.offline {
        background: var(--rule);
      }

      .text-ok {
        color: var(--ok);
      }

      .text-warn {
        color: var(--warn);
      }

      .text-bad {
        color: var(--bad);
      }

      .text-accent {
        color: var(--accent);
      }

      /* ── Bar Lists & Activity Lists ───────────────────────────── */
      .bar-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
      }

      .bar-row {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }

      .bar-row-top {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.75rem;
        min-width: 0;
      }

      .bar-label {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.84rem;
      }

      .bar-label-btn {
        background: none;
        border: none;
        padding: 0;
        color: var(--ink);
        cursor: pointer;
        text-align: left;
        font-size: 0.84rem;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .bar-label-btn:hover {
        color: var(--accent);
        text-decoration: underline;
      }

      .bar-val {
        flex-shrink: 0;
        font-size: 0.78rem;
        color: var(--ink-2);
      }

      .bar-track {
        height: 5px;
        border-radius: 999px;
        background: var(--card-subtle);
        overflow: hidden;
      }

      .bar-fill {
        height: 100%;
        border-radius: 999px;
        background: var(--accent);
      }

      .bar-fill.ok {
        background: var(--ok);
      }

      .event-list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .event-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.65rem;
        padding: 0.55rem 1rem;
        border-bottom: 1px solid var(--rule);
      }

      .event-item:last-child {
        border-bottom: none;
      }

      .event-main {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        min-width: 0;
        flex: 1;
      }

      .event-text {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.85rem;
      }

      .event-time {
        flex-shrink: 0;
        font-size: 0.76rem;
        color: var(--ink-2);
      }

      /* ── Filter Toolbars ──────────────────────────────────────── */
      .toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.55rem;
        margin-bottom: 0.85rem;
      }

      .toolbar .input-search {
        flex: 1 1 15rem;
        min-width: 12rem;
      }

      .toolbar .select-dev {
        flex: 0 1 14rem;
        min-width: 11rem;
      }

      .toggle-check {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.42rem 0.7rem;
        border: 1px solid var(--rule);
        border-radius: var(--radius-sm);
        background: var(--card);
        font-size: 0.84rem;
        cursor: pointer;
        user-select: none;
      }

      .toggle-check input {
        accent-color: var(--accent);
        margin: 0;
      }

      .toolbar-right {
        margin-left: auto;
        font-size: 0.8rem;
        color: var(--ink-2);
      }

      /* ── Tables ───────────────────────────────────────────────── */
      .table-scroll {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }

      table.data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.84rem;
      }

      table.data-table th {
        text-align: left;
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--ink-2);
        padding: 0.6rem 0.75rem;
        background: var(--card-subtle);
        border-bottom: 1px solid var(--rule);
        white-space: nowrap;
      }

      table.data-table td {
        padding: 0.6rem 0.75rem;
        border-bottom: 1px solid var(--rule);
        vertical-align: middle;
      }

      table.data-table tr:last-child td {
        border-bottom: none;
      }

      table.data-table tbody tr.clickable {
        cursor: pointer;
        transition: background-color 0.12s ease;
      }

      table.data-table tbody tr.clickable:hover {
        background: var(--card-subtle);
      }

      .cell-primary {
        font-weight: 500;
        color: var(--ink);
      }

      .cell-sub {
        display: block;
        font-size: 0.74rem;
        color: var(--ink-2);
        margin-top: 0.08rem;
      }

      .cell-wrap {
        word-break: break-word;
        overflow-wrap: anywhere;
      }

      .cell-trunc {
        max-width: 22rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .align-right {
        text-align: right;
      }

      /* ── Router Specs & Collectors ────────────────────────────── */
      .kv-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem 1rem;
      }

      .kv-item {
        display: flex;
        flex-direction: column;
        gap: 0.12rem;
        min-width: 0;
      }

      .kv-k {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--ink-2);
        font-weight: 600;
      }

      .kv-v {
        font-size: 0.92rem;
        font-weight: 500;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .collector-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem 1rem;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--rule);
      }

      .collector-row:last-child {
        border-bottom: none;
      }

      .collector-meta-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        margin-top: 0.35rem;
      }

      /* ── Empty States & Hints ─────────────────────────────────── */
      .empty {
        padding: 2rem 1.25rem;
        text-align: center;
        color: var(--ink-2);
        font-size: 0.875rem;
      }

      .empty-hint {
        max-width: 34rem;
        margin: 0.5rem auto 0;
        padding: 0.85rem 1rem;
        border-radius: var(--radius-sm);
        background: var(--card-subtle);
        border: 1px dashed var(--rule);
        text-align: left;
        font-size: 0.82rem;
        line-height: 1.55;
      }

      .empty-hint strong {
        color: var(--ink);
      }

      .empty-hint code {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        padding: 0.08rem 0.32rem;
        border-radius: 4px;
        background: var(--muted-bg);
        color: var(--ink);
      }

      /* ── Device Inspector Drawer ──────────────────────────────── */
      .drawer-backdrop {
        position: fixed;
        inset: 0;
        z-index: 50;
        background: rgba(14, 19, 38, 0.52);
        backdrop-filter: blur(2px);
        display: flex;
        justify-content: flex-end;
      }

      .drawer-backdrop[hidden] {
        display: none;
      }

      .drawer {
        width: min(42rem, 100vw);
        height: 100dvh;
        background: var(--paper);
        border-left: 1px solid var(--rule);
        box-shadow: var(--shadow-lg);
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      .drawer-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem 1.25rem;
        background: var(--card);
        border-bottom: 1px solid var(--rule);
      }

      .drawer-title {
        font-family: var(--font-serif);
        font-size: 1.2rem;
        font-weight: 600;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .drawer-sub {
        margin-top: 0.2rem;
        font-size: 0.78rem;
        color: var(--ink-2);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
      }

      .drawer-body {
        flex: 1;
        overflow-y: auto;
        padding: 1rem 1.25rem 2rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .rename-form {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
      }

      .rename-form .input {
        flex: 1 1 12rem;
      }

      .rename-status {
        font-size: 0.78rem;
        font-weight: 500;
      }

      .drawer-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      /* Loading shimmer */
      .loading-note {
        padding: 2rem 1rem;
        text-align: center;
        color: var(--ink-2);
        font-size: 0.85rem;
      }

      .sev-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
      }

      .sev-pill {
        border: 1px solid var(--rule);
        background: var(--card);
        color: var(--ink-2);
        border-radius: 999px;
        padding: 0.22rem 0.65rem;
        font-size: 0.76rem;
        font-weight: 500;
        cursor: pointer;
      }

      .sev-pill.active {
        background: var(--accent-bg);
        border-color: var(--accent);
        color: var(--accent);
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    {!signedIn ? (
      <main class="gate-wrap">
        <section class="gate-card" aria-label="Sign in">
          <h1 class="gate-brand">
            <span class="gate-dot" aria-hidden="true"></span>
            net
          </h1>
          <p class="gate-sub">Private network telemetry dashboard.</p>
          {error && (
            <p class="gate-error" role="alert">
              {error}
            </p>
          )}
          <form class="gate-form" method="POST" action="/net">
            <label class="sr-only" for="net-password">Password</label>
            <input
              id="net-password"
              class="input"
              type="password"
              name="password"
              autocomplete="current-password"
              placeholder="Enter password"
              required
              autofocus
            />
            <button class="btn btn-primary" type="submit">Sign in</button>
          </form>
        </section>
      </main>
    ) : (
      <div class="app" id="netmon-app">
        <header class="topbar">
          <div class="topbar-left">
            <h1 class="brand">net</h1>
            <div class="pill muted" id="collector-pill" title="Collector status">
              <span class="dot" aria-hidden="true"></span>
              <span id="collector-pill-text">Connecting…</span>
            </div>
          </div>
          <div class="topbar-controls">
            <label class="sr-only" for="day-select">Date (IST)</label>
            <select id="day-select" class="select mono" title="Day (IST)"></select>
            <button
              id="auto-btn"
              class="btn btn-active"
              type="button"
              aria-pressed="true"
              title="Toggle 15s auto-refresh"
            >
              Auto 15s: On
            </button>
            <button id="refresh-btn" class="btn" type="button">Refresh</button>
            <button id="logout-btn" class="btn btn-ghost" type="button">Sign out</button>
          </div>
        </header>

        <nav class="tabs" role="tablist" aria-label="Dashboard sections">
          <button class="tab" type="button" role="tab" data-tab="overview" aria-selected="true" aria-controls="panel-overview">
            Overview
          </button>
          <button class="tab" type="button" role="tab" data-tab="devices" aria-selected="false" aria-controls="panel-devices">
            Devices <span class="tab-badge" id="badge-devices">—</span>
          </button>
          <button class="tab" type="button" role="tab" data-tab="dns" aria-selected="false" aria-controls="panel-dns">
            DNS Traffic <span class="tab-badge" id="badge-dns">—</span>
          </button>
          <button class="tab" type="button" role="tab" data-tab="flows" aria-selected="false" aria-controls="panel-flows">
            Connections <span class="tab-badge" id="badge-flows">—</span>
          </button>
          <button class="tab" type="button" role="tab" data-tab="router" aria-selected="false" aria-controls="panel-router">
            Router &amp; Syslog
          </button>
        </nav>

        <div id="net-banner" class="banner" role="alert" hidden>
          <span id="net-banner-text"></span>
          <button id="net-banner-retry" class="btn btn-sm" type="button">Retry</button>
        </div>

        <!-- 1. OVERVIEW -->
        <section id="panel-overview" class="panel" role="tabpanel">
          <div class="kpi-grid" id="kpi-grid">
            <div class="kpi"><span class="kpi-label">Online Devices</span><span class="kpi-value">—</span><span class="kpi-sub">Loading…</span></div>
            <div class="kpi"><span class="kpi-label">WAN Throughput</span><span class="kpi-value">—</span><span class="kpi-sub">Loading…</span></div>
            <div class="kpi"><span class="kpi-label">GPON Health</span><span class="kpi-value">—</span><span class="kpi-sub">Loading…</span></div>
            <div class="kpi"><span class="kpi-label">DNS Queries</span><span class="kpi-value">—</span><span class="kpi-sub">Loading…</span></div>
            <div class="kpi"><span class="kpi-label">Active Flows</span><span class="kpi-value">—</span><span class="kpi-sub">Loading…</span></div>
          </div>

          <article class="card">
            <div class="card-head">
              <h2 class="card-title">WAN Throughput</h2>
              <div class="card-meta" id="wan-chart-meta">
                <span class="chart-legend">
                  <span class="legend-item"><span class="legend-swatch" style="background: var(--accent);"></span>Down</span>
                  <span class="legend-item"><span class="legend-swatch" style="background: var(--ok);"></span>Up</span>
                </span>
                <span class="mono" id="wan-chart-peak"></span>
              </div>
            </div>
            <div class="card-body">
              <div class="chart-wrap" id="wan-chart-wrap">
                <div class="loading-note">Loading WAN telemetry…</div>
              </div>
            </div>
          </article>

          <div class="grid-2">
            <article class="card">
              <div class="card-head">
                <h2 class="card-title">Recent Device Activity</h2>
                <span class="card-meta" id="overview-events-meta"></span>
              </div>
              <div class="card-body card-body-flush" id="overview-events">
                <div class="loading-note">Loading events…</div>
              </div>
            </article>

            <article class="card">
              <div class="card-head">
                <h2 class="card-title">Top Queried Domains</h2>
                <span class="card-meta" id="overview-domains-meta"></span>
              </div>
              <div class="card-body" id="overview-domains">
                <div class="loading-note">Loading domains…</div>
              </div>
            </article>
          </div>

          <div class="grid-2">
            <article class="card">
              <div class="card-head">
                <h2 class="card-title">Top DNS Talkers</h2>
                <span class="card-meta" id="overview-talkers-meta"></span>
              </div>
              <div class="card-body" id="overview-talkers">
                <div class="loading-note">Loading clients…</div>
              </div>
            </article>

            <article class="card">
              <div class="card-head">
                <h2 class="card-title">Top Remote Destinations</h2>
                <span class="card-meta" id="overview-dests-meta"></span>
              </div>
              <div class="card-body" id="overview-dests">
                <div class="loading-note">Loading destinations…</div>
              </div>
            </article>
          </div>
        </section>

        <!-- 2. DEVICES -->
        <section id="panel-devices" class="panel" role="tabpanel" hidden>
          <div class="toolbar">
            <input
              id="dev-search"
              class="input input-search"
              type="search"
              placeholder="Search name, hostname, IP, MAC, or SSID…"
              aria-label="Filter devices"
            />
            <label class="toggle-check">
              <input id="dev-online-only" type="checkbox" />
              <span>Online only</span>
            </label>
            <span class="toolbar-right mono" id="dev-count"></span>
          </div>

          <article class="card">
            <div class="table-scroll" id="dev-table-wrap">
              <div class="loading-note">Loading devices…</div>
            </div>
          </article>
        </section>

        <!-- 3. DNS TRAFFIC -->
        <section id="panel-dns" class="panel" role="tabpanel" hidden>
          <form class="toolbar" id="dns-filter-form">
            <input
              id="dns-search"
              class="input input-search"
              type="search"
              placeholder="Filter domain, answer, or IP…"
              aria-label="Filter DNS traffic"
            />
            <select id="dns-mac-select" class="select select-dev" aria-label="Filter DNS by device">
              <option value="">All devices</option>
            </select>
            <button class="btn" type="submit">Apply</button>
            <button id="dns-clear-btn" class="btn btn-ghost" type="button">Clear</button>
          </form>

          <article class="card" id="dns-top-card">
            <div class="card-head">
              <h2 class="card-title">Top Domains</h2>
              <span class="card-meta" id="dns-top-meta"></span>
            </div>
            <div class="card-body" id="dns-top-domains"></div>
          </article>

          <article class="card">
            <div class="card-head">
              <h2 class="card-title">Live DNS Query Log</h2>
              <span class="card-meta mono" id="dns-log-meta"></span>
            </div>
            <div class="table-scroll" id="dns-log-wrap">
              <div class="loading-note">Loading DNS log…</div>
            </div>
          </article>
        </section>

        <!-- 4. CONNECTIONS -->
        <section id="panel-flows" class="panel" role="tabpanel" hidden>
          <form class="toolbar" id="flow-filter-form">
            <input
              id="flow-search"
              class="input input-search"
              type="search"
              placeholder="Filter host, SNI, IP, or port…"
              aria-label="Filter connections"
            />
            <select id="flow-mac-select" class="select select-dev" aria-label="Filter connections by device">
              <option value="">All devices</option>
            </select>
            <button class="btn" type="submit">Apply</button>
            <button id="flow-clear-btn" class="btn btn-ghost" type="button">Clear</button>
          </form>

          <article class="card" id="flow-top-card">
            <div class="card-head">
              <h2 class="card-title">Top Remote Destinations</h2>
              <span class="card-meta" id="flow-top-meta"></span>
            </div>
            <div class="card-body" id="flow-top-dests"></div>
          </article>

          <article class="card">
            <div class="card-head">
              <h2 class="card-title">Live Flows</h2>
              <span class="card-meta mono" id="flow-log-meta"></span>
            </div>
            <div class="table-scroll" id="flow-log-wrap">
              <div class="loading-note">Loading connections…</div>
            </div>
          </article>
        </section>

        <!-- 5. ROUTER & SYSLOG -->
        <section id="panel-router" class="panel" role="tabpanel" hidden>
          <div class="grid-3" id="router-cards">
            <article class="card"><div class="loading-note">Loading router telemetry…</div></article>
          </div>

          <article class="card">
            <div class="card-head">
              <h2 class="card-title">Collectors</h2>
              <div class="card-meta">
                <span id="collectors-meta"></span>
                <button id="logout-all-btn" class="btn btn-sm btn-danger-ghost" type="button">Sign out all sessions</button>
              </div>
            </div>
            <div class="card-body card-body-flush" id="collectors-list">
              <div class="loading-note">Loading collectors…</div>
            </div>
          </article>

          <article class="card">
            <div class="card-head">
              <h2 class="card-title">Router Syslog</h2>
              <div class="card-meta">
                <div class="sev-pills" id="syslog-sev-pills">
                  <button type="button" class="sev-pill active" data-sev="all">All</button>
                  <button type="button" class="sev-pill" data-sev="err">Error</button>
                  <button type="button" class="sev-pill" data-sev="warn">Warn</button>
                  <button type="button" class="sev-pill" data-sev="info">Info</button>
                </div>
                <span class="mono" id="syslog-meta"></span>
              </div>
            </div>
            <div class="table-scroll" id="syslog-wrap">
              <div class="loading-note">Loading syslog…</div>
            </div>
          </article>
        </section>
      </div>

      <!-- DEVICE INSPECTOR DRAWER -->
      <div id="device-drawer-backdrop" class="drawer-backdrop" hidden>
        <aside class="drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
          <div class="drawer-head">
            <div>
              <h2 class="drawer-title" id="drawer-title">Device</h2>
              <div class="drawer-sub" id="drawer-sub"></div>
            </div>
            <button id="drawer-close" class="btn btn-sm btn-ghost" type="button" aria-label="Close inspector">✕ Close</button>
          </div>
          <div class="drawer-body" id="drawer-body">
            <div class="loading-note">Loading device details…</div>
          </div>
        </aside>
      </div>

      <script src="../../scripts/netmon/app.ts"></script>
    )}
  </body>
</html>
