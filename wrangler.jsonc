{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kirtansite",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],

  // NOTE: once this file exists, it is the source of truth for the Pages
  // project and the dashboard's bindings/vars panel is ignored. Secrets are
  // still managed separately, with `wrangler pages secret put`.

  "vars": {
    // /learning refuses to serve on any other hostname. This is what closes
    // the *.pages.dev and preview-branch exposure, which no amount of
    // robots.txt can.
    "LEARNING_HOST": "kirtanjain.com",
    // Same rule for /gree, the GRE/TOEFL English trainer.
    "GREE_HOST": "kirtanjain.com",
    // And for /major, the quiz revision deck.
    "MAJOR_HOST": "kirtanjain.com"
  },

  // Astro's session store. Nothing in /learning uses Astro sessions, but the
  // Cloudflare adapter wires them up by default and errors at runtime if the
  // binding it expects is missing, so it is cheaper to provide one than to
  // find out which code path needs it.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "bd66b23481b941de8496a8215556344b"
    }
  ],

  "d1_databases": [
    {
      "binding": "LEARNING_DB",
      "database_name": "learning",
      "database_id": "a7142589-d293-4233-aad7-d816bdfa3333"
    },
    {
      // /gree progress. Its own database so none of it mixes with /learning.
      "binding": "GREE_DB",
      "database_name": "gree",
      "database_id": "701da37f-7785-435d-b395-aa3b64004865"
    }
  ],

  "r2_buckets": [
    {
      "binding": "LEARNING_FILES",
      "bucket_name": "learning-uploads"
    },
    {
      // /major: slide images, data.json and playbook.md. Private bucket, no
      // public URL; everything is served through the signed-in routes.
      "binding": "MAJOR_FILES",
      "bucket_name": "major-prep"
    }
  ],

  "env": {
    // Preview deployments get NO bindings on purpose. /learning degrades to a
    // "not available here" page rather than pointing a second, unauthenticated
    // front door at the real database.
    "preview": {
      "vars": {
        "LEARNING_HOST": "disabled",
        "GREE_HOST": "disabled",
        "MAJOR_HOST": "disabled"
      }
    }
  }
}
